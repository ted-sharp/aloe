[Shape]
Page=cache
Left=1498
Top=95
ZOrder=26
Width=2270
Height=773
ShapeType=Rectangle
Text=CREATE OR REPLACE FUNCTION fn_update_cache_updates()\nRETURNS TRIGGER AS $$\nBEGIN\n  INSERT INTO cache_updates (table_name, latest_updated_at, latest_updated_user_id, latest_updated_session_id)\n  VALUES (TG_TABLE_NAME, NOW(), NEW.latest_updated_user_id, NEW.latest_updated_session_id)\n  ON CONFLICT (table_name)\n  DO UPDATE SET\n    latest_updated_at = EXCLUDED.latest_updated_at,\n    latest_updated_user_id = EXCLUDED.latest_updated_user_id,\n    latest_updated_session_id = EXCLUDED.latest_updated_session_id;\n\n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n\n
FontName=Tahoma
FontSize=12
FontColor=$000000
TextAlign=$0

