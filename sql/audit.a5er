[Shape]
Page=cache
Left=1498
Top=95
ZOrder=26
Width=2270
Height=773
ShapeType=Rectangle
Text=CREATE OR REPLACE FUNCTION update_cache_updates()\nRETURNS TRIGGER AS $$\nBEGIN\n  INSERT INTO cache_updates (table_name, latest_updated_at, latest_update_user_id, latest_update_session_id)\n  VALUES (TG_TABLE_NAME, NOW(), NEW.update_user_id, NEW.update_session_id)\n  ON CONFLICT (table_name)\n  DO UPDATE SET\n    latest_updated_at = EXCLUDED.latest_updated_at,\n    latest_update_user_id = EXCLUDED.latest_update_user_id,\n    latest_update_session_id = EXCLUDED.latest_update_session_id;\n\n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n
FontName=Tahoma
FontSize=12
FontColor=$000000
TextAlign=$0

[Shape]
Page=cache
Left=1503
Top=1098
ZOrder=27
Width=2270
Height=230
ShapeType=Rectangle
Text=CREATE TRIGGER employees_cache_update_trigger\nAFTER INSERT OR UPDATE OR DELETE ON employees\nFOR EACH ROW EXECUTE FUNCTION update_cache_updates();\n
FontName=Tahoma
FontSize=12
FontColor=$000000
TextAlign=$0
