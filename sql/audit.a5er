[Shape]
Page=AUDIT
Left=1106
Top=103
ZOrder=14
Width=1196
Height=1638
ShapeType=Rectangle
Text=CREATE OR REPLACE FUNCTION log_changes()\nRETURNS TRIGGER AS $$\nBEGIN\n  -- change_logs テーブルへ挿入\n  INSERT INTO change_logs (\n    is_archived,\n    table_name,\n    record_id,\n    changed_action,\n    changed_user_id,\n    changed_user_name,\n    changed_at,\n    session_id,\n    sql_statement,\n    old_values,\n    new_values\n  ) VALUES (\n    FALSE,  -- パーティション用\n    TG_TABLE_NAME,\n    NEW.id,  -- 主キーのカラム名に置き換えてください\n    TG_OP,  -- \qINSERT\q または \qUPDATE\q\n    NEW.changed_user_id,\n    NEW.changed_user_name,\n    NOW(),\n    NEW.session_id,\n    current_query(),  -- 必要に応じて修正\n    to_jsonb(OLD),\n    to_jsonb(NEW)\n  );\n\n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n
FontName=Tahoma
FontSize=12
FontColor=$000000
TextAlign=$0

[Shape]
Page=AUDIT
Left=2604
Top=103
ZOrder=15
Width=1082
Height=262
ShapeType=Rectangle
Text=CREATE TRIGGER your_table_change_log_trigger\nAFTER INSERT OR UPDATE ON your_table\nFOR EACH ROW EXECUTE FUNCTION log_changes();\n
FontName=Tahoma
FontSize=12
FontColor=$000000
TextAlign=$0

