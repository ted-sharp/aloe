[Shape]
Page=AUDIT
Left=1095
Top=151
ZOrder=14
Width=2270
Height=934
ShapeType=Rectangle
Text=CREATE OR REPLACE FUNCTION logging.log_changes() RETURNS TRIGGER AS $$\nBEGIN\n    IF (TG_OP = \qDELETE\q) THEN\n        INSERT INTO logging.change_logs(table_name, record_id, changed_by, change_type, old_values)\n        VALUES (TG_TABLE_NAME, OLD.id, current_user, TG_OP, row_to_json(OLD));\n        RETURN OLD;\n    ELSIF (TG_OP = \qINSERT\q) THEN\n        INSERT INTO logging.change_logs(table_name, record_id, changed_by, change_type, new_values)\n        VALUES (TG_TABLE_NAME, NEW.id, current_user, TG_OP, row_to_json(NEW));\n        RETURN NEW;\n    ELSIF (TG_OP = \qUPDATE\q) THEN\n        INSERT INTO logging.change_logs(table_name, record_id, changed_by, change_type, old_values, new_values)\n        VALUES (TG_TABLE_NAME, NEW.id, current_user, TG_OP, row_to_json(OLD), row_to_json(NEW));\n        RETURN NEW;\n    END IF;\nEND;\n$$ LANGUAGE plpgsql;\n
FontName=Tahoma
FontSize=12
FontColor=$000000
TextAlign=$0

[Shape]
Page=AUDIT
Left=1103
Top=1188
ZOrder=15
Width=2286
Height=590
ShapeType=Rectangle
Text=CREATE TRIGGER trigger_log_changes\nALTER INSERT OR UPDATE OR DELETE ON your_table_name\nFOR EACH ROW EXECUTE FUNCTION logging.log_changes();\n\nトリガを設定することで変更履歴を追えるが、パフォーマンスに影響が出るため、特定のテーブルのみとするのがよい。\n
FontName=Tahoma
FontSize=12
FontColor=$000000
TextAlign=$0

