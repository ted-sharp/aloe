[Shape]
Page=audit
Left=1103
Top=98
ZOrder=32
Width=1516
Height=1781
ShapeType=Rectangle
Text=CREATE OR REPLACE FUNCTION fn_log_changes(pk_column_name TEXT)\nRETURNS TRIGGER AS $$\nDECLARE\n  pk_value TEXT;\nBEGIN\n  -- 主キーの値を取得する（NEW または OLD のどちらかを使用）\n  EXECUTE format(\qSELECT ($1).%I\q, pk_column_name)\n  INTO pk_value\n  USING COALESCE(NEW, OLD);\n\n  -- change_logs テーブルへ挿入\n  INSERT INTO change_logs (\n    table_name,\n    record_id,\n    changed_action,\n    changed_user_id,\n    changed_user_name,\n    changed_at,\n    changed_session_id,\n    sql_statement,\n    old_values,\n    new_values\n  ) VALUES (\n    TG_TABLE_NAME,\n    pk_value,  -- 主キーの値\n    TG_OP,  -- \qINSERT\q または \qUPDATE\q\n    NEW.changed_user_id,\n    NEW.changed_user_name,\n    NOW(),\n    NEW.changed_session_id,\n    current_query(),\n    to_jsonb(OLD),\n    to_jsonb(NEW)\n  );\n\n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n
FontName=Tahoma
FontSize=12
FontColor=$000000
TextAlign=$0
