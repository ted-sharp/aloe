@* 自ユーザーアバター（タップでドロップダウン） *@

@if (_menuOpen)
{
    <div class="fixed inset-0 z-[999] bg-black/30 backdrop-blur-sm"
         @onclick="CloseMenu"
         aria-hidden="true">
    </div>
}

<div class="relative">
    <button class="btn btn-circle h-10 w-10 z-[1000]"
            @onclick="ToggleMenu"
            aria-label="ユーザーメニュー">
        <div class="avatar placeholder">
            <div class="bg-emerald-500 text-white rounded-full w-10 h-10 flex items-center justify-center">
                <span class="text-sm whitespace-nowrap select-none">@UserInitial</span>
            </div>
        </div>
    </button>

    @if (_menuOpen)
    {
        <div class="absolute right-0 top-12 z-[1001] w-64 bg-base-100 rounded-box shadow-2xl overflow-hidden">
            <div class="p-3 border-b border-base-300 bg-base-200/50">
                <p class="font-semibold truncate">@UserDisplayName</p>
                <p class="text-sm text-base-content/60 truncate">@UserEmail</p>
            </div>
            <div class="p-3 border-b border-base-300">
                <p class="text-xs text-base-content/50 mb-1">現在の施設</p>
                <p class="font-medium truncate">@FacilityName</p>
            </div>
            <ul class="menu p-2">
                <li>
                    <a href="/api/auth/logout" class="flex items-center gap-2 text-error">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                        </svg>
                        ログアウト
                    </a>
                </li>
            </ul>
        </div>
    }
</div>
