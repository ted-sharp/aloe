@* 施設選択モーダル *@

<!-- モーダルバックドロップ -->
<div class="fixed inset-0 bg-black/50 backdrop-blur-sm z-[2000] flex items-center justify-center p-4"
     @onclick="HandleBackdropClick">
    <div class="bg-base-100 rounded-box shadow-2xl w-full max-w-md max-h-[80vh] flex flex-col"
         @onclick:stopPropagation="true">
        <!-- ヘッダー -->
        <div class="p-4 border-b border-base-300 flex items-center justify-between">
            <h3 class="font-bold text-lg">施設を選択</h3>
            <button class="btn btn-sm btn-circle btn-ghost" @onclick="Close">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- 施設リスト -->
        <div class="overflow-y-auto flex-1 p-2">
            @if (GroupedFacilities != null && GroupedFacilities.Any())
            {
                @foreach (var tenantGroup in GroupedFacilities)
                {
                    <!-- テナントグループ -->
                    <div class="mb-3">
                        <div class="px-3 py-1 text-xs font-semibold text-base-content/60 uppercase tracking-wider">
                            @tenantGroup.Key
                        </div>
                        <ul class="menu p-0">
                            @foreach (var facility in tenantGroup.Value)
                            {
                                var isSelected = facility.FacilityId == CurrentFacilityId;
                                <li>
                                    <button class="@(isSelected ? "active" : "") flex items-center gap-3"
                                            @onclick="() => SelectFacility(facility.FacilityId)">
                                        <!-- 施設アイコン -->
                                        <div class="avatar placeholder">
                                            <div class="@(isSelected ? "bg-primary text-primary-content" : "bg-base-300 text-base-content") rounded w-8">
                                                <span class="text-sm">@facility.FacilityName[..1]</span>
                                            </div>
                                        </div>
                                        <div class="flex-1 text-left">
                                            <p class="font-medium">@facility.FacilityName</p>
                                            @if (facility.IsFacilityAdmin)
                                            {
                                                <span class="badge badge-xs badge-primary">管理者</span>
                                            }
                                        </div>
                                        @if (isSelected)
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                            </svg>
                                        }
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-8 text-base-content/50">
                    <p>アクセス可能な施設がありません</p>
                </div>
            }
        </div>

        <!-- フッター -->
        <div class="p-3 border-t border-base-300 flex justify-end">
            <button class="btn btn-ghost btn-sm" @onclick="Close">
                キャンセル
            </button>
        </div>
    </div>
</div>
