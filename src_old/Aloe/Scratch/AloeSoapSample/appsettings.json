{
  "AzureSpeech": {
    "SubscriptionKey": "your-real-key",
    "Region": "your-region"
  },
  "AzureOpenAI": {
    "DeploymentName": "your-deployment-name",
    "Endpoint": "https://your-resource-name.openai.azure.com/",
    "ApiKey": "your-api-key",
    "ModelId": "your-model-id"
  },
  "LMStudio": {
    "Endpoint": "http://localhost:1234/v1",
    "ModelId": "your-model-id"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Database=aloedb;Username=postgres;Password=postgres;CommandTimeout=0;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    },
    "BufferingSinkOptions": {
      "BatchSize": 1000,
      "FlushIntervalSeconds": 10,
      "EagerlyEmitFirstEvent": true
    }
  }
}
