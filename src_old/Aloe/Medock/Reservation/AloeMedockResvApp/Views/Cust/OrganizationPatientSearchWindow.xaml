<Window
    x:Class="Aloe.Medock.Reservation.AloeMedockResvApp.Views.Cust.OrganizationPatientSearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bhv="clr-namespace:Aloe.Common.AloeCoreLib.Wpf.Behaviors;assembly=Aloe.Common.AloeCoreLib.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:views="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.Views"
    xmlns:vm="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.ViewModels"
    Title="団体 受診者 検索"
    Width="1920"
    Height="1080"
    bhv:Key.KeyDownCommand="{Binding FunctionBarVm.KeyDownCommand}"
    d:DataContext="{d:DesignInstance Type=vm:ReservationEquipViewModel}"
    d:Height="480"
    d:Width="640"
    ResizeMode="CanResizeWithGrip"
    mc:Ignorable="d">

    <DockPanel LastChildFill="True">
        <views:InformationBar DataContext="{Binding InformationBarVm}" DockPanel.Dock="Bottom" />
        <views:FunctionBar DataContext="{Binding FunctionBarVm}" DockPanel.Dock="Bottom" />

        <Grid>
            <TabControl
                x:Name="EquipTabControl"
                IsEnabled="{Binding FunctionBarVm.SharedCanExecute.Value}"
                ItemsSource="{Binding ReservationEquipTabItems}"
                PreviewMouseWheel="EquipTabControl_OnPreviewMouseWheel"
                SelectionChanged="EquipTabControl_OnSelectionChanged">
                <TabItem Header="団体">
                    <DataGrid />
                </TabItem>
                <TabItem Header="受診者">
                    <DataGrid />
                </TabItem>
            </TabControl>


            <Expander DockPanel.Dock="Top" IsExpanded="False">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <Label />
                        <Label>企業</Label>
                        <Label>No.</Label>
                        <TextBox MinWidth="80" Text="{Binding StartDate.Value}" />
                        <Label>カナ</Label>
                        <TextBox MinWidth="80" Text="{Binding StartDate.Value}" />
                        <Label>Tel.</Label>
                        <TextBox MinWidth="80" Text="{Binding StartDate.Value}" />
                        <Label>/</Label>
                    </StackPanel>
                </Expander.Header>
                <Expander.Content>
                    <StackPanel Background="Azure">
                        <Label>Floor1</Label>
                        <Label>Floor2</Label>
                        <Label>月、火、水、木、金、土、日</Label>
                        <Label>AM、PM</Label>
                        <Label>その他条件など</Label>
                    </StackPanel>
                </Expander.Content>
            </Expander>

            <ui:Snackbar
                x:Name="Snackbar"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                MessageQueue="{Binding SnackbarMessageQueue}" />
        </Grid>

    </DockPanel>
</Window>
