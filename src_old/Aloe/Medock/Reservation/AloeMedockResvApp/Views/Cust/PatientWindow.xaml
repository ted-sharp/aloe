<Window
    x:Class="Aloe.Medock.Reservation.AloeMedockResvApp.Views.Cust.PatientWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bhv="http://schemas.aloe/wpf/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.Views.Cust"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:views="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.Views"
    xmlns:vm="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.ViewModels"
    Title="個人"
    Width="640"
    Height="1080"
    MinWidth="640"
    MinHeight="480"
    bhv:Key.KeyDownCommand="{Binding FunctionBarVm.KeyDownCommand}"
    d:DataContext="{d:DesignInstance Type=vm:ReservationEquipViewModel}"
    d:Height="1080"
    d:Width="640"
    ResizeMode="CanResizeWithGrip"
    mc:Ignorable="d">

    <Window.Resources>
        <Style TargetType="ui:PackIcon">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="1" />
        </Style>
        <!--<Style TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>-->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="Red" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <views:InformationBar DataContext="{Binding InformationBarVm}" DockPanel.Dock="Bottom" />
        <views:FunctionBar DataContext="{Binding FunctionBarVm}" DockPanel.Dock="Bottom" />

        <Border
            Margin="3"
            Padding="3"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="3"
            DockPanel.Dock="Top">
            <local:PatientBar />
        </Border>

        <Grid>
            <!--  ここでTransformで拡大率を設定したい  -->

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TabControl>
                    <TabItem Header="患者基本情報">
                        <ScrollViewer
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                            <local:PatientBasicPanel />
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="やりとり" />

                    <TabItem Header="ファイル" />

                    <TabItem Header="オーダー" />

                    <TabItem Header="受付" />

                    <TabItem Header="予約" />

                </TabControl>

            </Grid>



            <ui:Snackbar
                x:Name="Snackbar"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                MessageQueue="{Binding SnackbarMessageQueue}" />
        </Grid>

    </DockPanel>
</Window>
