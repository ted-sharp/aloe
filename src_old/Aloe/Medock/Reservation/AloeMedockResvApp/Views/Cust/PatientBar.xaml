<UserControl
    x:Class="Aloe.Medock.Reservation.AloeMedockResvApp.Views.Cust.PatientBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.Views.Cust"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://materialdesigninxaml.net/winfx/xaml/themes"
    d:Background="PaleGreen"
    d:DesignHeight="80"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Margin" Value="3,0,3,1" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3,0,3,1" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Resources>


    <DockPanel>
        <Grid DockPanel.Dock="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:PackIcon
                Grid.Row="0"
                Grid.Column="0"
                Kind="History" />
            <TextBlock Grid.Row="0" Grid.Column="1">yyyy/MM/dd HH:mm:ss by user</TextBlock>
            <ui:PackIcon
                Grid.Row="1"
                Grid.Column="0"
                Kind="Key" />
            <TextBlock Grid.Row="1" Grid.Column="1">yyyy/MM/dd HH:mm:ss by user</TextBlock>
        </Grid>

        <Grid DockPanel.Dock="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0">患者No.</TextBlock>
            <ui:PackIcon
                Grid.Row="0"
                Grid.Column="1"
                Kind="Numeric" />
            <TextBox
                Grid.Row="0"
                Grid.Column="2"
                MinWidth="80" />

            <TextBlock Grid.Row="0" Grid.Column="3">カルテNo.</TextBlock>
            <ui:PackIcon
                Grid.Row="0"
                Grid.Column="4"
                Kind="Numeric" />
            <TextBox
                Grid.Row="0"
                Grid.Column="5"
                MinWidth="80" />

            <ui:PackIcon
                Grid.Row="1"
                Grid.Column="1"
                Kind="Person" />
            <Grid
                Grid.Row="1"
                Grid.Column="2"
                Grid.ColumnSpan="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0">{FullName}</TextBlock>
                <TextBlock Grid.Column="1" FontSize="9">{M/F}</TextBlock>
                <ui:PackIcon
                    Grid.Column="2"
                    Height="11"
                    Kind="BirthdayCakeOutline" />
                <TextBlock Grid.Column="3" FontSize="9">{yyyy/MM/dd}</TextBlock>
                <TextBlock Grid.Column="4" FontSize="9">満 {x} 歳</TextBlock>
                <TextBlock Grid.Column="5" FontSize="9">(年度内 {x} 歳)</TextBlock>
            </Grid>

            <ui:PackIcon
                Grid.Row="2"
                Grid.Column="1"
                Height="11"
                Kind="MapMarkerRadiusOutline" />
            <Grid
                Grid.Row="2"
                Grid.Column="2"
                Grid.ColumnSpan="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="9">{Address}</TextBlock>
                <ui:PackIcon
                    Grid.Column="1"
                    Height="11"
                    Kind="Telephone" />
                <TextBlock Grid.Column="2" FontSize="9">{Phone}</TextBlock>
                <ui:PackIcon
                    Grid.Column="3"
                    Height="11"
                    Kind="EMail" />
                <TextBlock Grid.Column="4" FontSize="9">{Mail}</TextBlock>
            </Grid>

            <ui:PackIcon
                Grid.Row="3"
                Grid.Column="1"
                Kind="NoteTextOutline" />
            <TextBlock
                Grid.Row="3"
                Grid.Column="2"
                Grid.ColumnSpan="5">
                {Memo}
            </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>
