<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    xmlns:vm="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.ViewModels"
    mc:Ignorable="d">
    <ContextMenu
        x:Key="SysTrayMenu"
        d:DataContext="{d:DesignInstance Type=vm:NotifyIconViewModel}"
        x:Shared="false">
        <MenuItem Command="{Binding ShowReservationMainWindowCommand}" Header="予約状況(メイン)" />
        <MenuItem Command="{Binding ShowXxxWindowCommand}" Header="団体患者検索" />
        <MenuItem Command="{Binding ShowLogWindowCommand}" Header="ログ" />
        <MenuItem Command="{Binding ShowMaintenanceWindowCommand}" Header="設定" />
        <MenuItem Command="{Binding ShowXxxWindowCommand}" Header="バージョン情報" />
        <Separator />
        <MenuItem Command="{Binding LogoutCommand}" Header="ログアウト" />
        <Separator />
        <MenuItem Command="{Binding RestartAppCommand}" Header="再起動" />
        <MenuItem Command="{Binding ExitAppCommand}" Header="終了" />
    </ContextMenu>

    <!--  the application's NotifyIcon - started from App.xaml.cs. Declares its own view model.  -->
    <tb:TaskbarIcon
        x:Key="NotifyIcon"
        d:DataContext="{d:DesignInstance Type=vm:NotifyIconViewModel}"
        ContextMenu="{StaticResource SysTrayMenu}"
        IconSource="/Assets/MaterialIcons/favorite_24dp_EA3323_FILL1_wght400_GRAD0_opsz24.ico"
        LeftClickCommand="{Binding ShowReservationMainWindowCommand}"
        NoLeftClickDelay="True"
        ToolTipText="ReservationApp" />
</ResourceDictionary>