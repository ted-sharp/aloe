<Window
    x:Class="Aloe.Medock.Reservation.AloeMedockResvApp.Views.Resv.ReservationMainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Aloe.Common.AloeCoreLib.Wpf.Behaviors;assembly=Aloe.Common.AloeCoreLib.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.Views.Resv"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.Views"
    xmlns:vm="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.ViewModels"
    Title="予約(メイン)"
    Width="1920"
    Height="1080"
    MinWidth="640"
    MinHeight="480"
    behaviors:Key.KeyDownCommand="{Binding FunctionBarVm.KeyDownCommand}"
    d:DataContext="{d:DesignInstance Type=vm:ReservationEquipViewModel}"
    d:Height="480"
    d:Width="640"
    Icon="/Assets/MaterialIcons/grass_24dp_75FB4C_FILL1_wght400_GRAD0_opsz24.ico"
    ResizeMode="CanResizeWithGrip"
    mc:Ignorable="d">

    <DockPanel LastChildFill="True">

        <views:InformationBar DataContext="{Binding InformationBarVm}" DockPanel.Dock="Bottom" />
        <views:FunctionBar DataContext="{Binding FunctionBarVm}" DockPanel.Dock="Bottom" />


        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Label>予約日</Label>
            <TextBox
                x:Name="CalendarMonthTextBox"
                MinWidth="80"
                IsEnabled="{Binding FunctionBarVm.SharedCanExecute.Value}"
                Text="{Binding StartMonth.Value}" />
            <Label>フロア1</Label>
            <Label>フロア2</Label>
            <Label>自動更新</Label>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Viewbox
                Grid.Row="1"
                Grid.Column="0"
                MaxWidth="150">
                <Calendar />
            </Viewbox>
            <Label Grid.Row="2" Grid.Column="0">備考</Label>
            <TextBox
                Grid.Row="3"
                Grid.Column="0"
                Text="[備考]" />

            <!--<local:ReservationEquipDailyGrid
                Grid.Row="0" Grid.Column="1" Grid.RowSpan="4"
                x:Name="EquipTabControl"
                IsEnabled="{Binding FunctionBarVm.SharedCanExecute.Value}"
                DataContext="{Binding .}"
            >
                <local:ReservationEquipDailyGrid.LayoutTransform>
                    <ScaleTransform
                        ScaleX="{
                                Binding DataContext.InformationBarVm.SelectedScalePercentage.Value,
                                RelativeSource={RelativeSource AncestorType=Window},
                                Converter={StaticResource Int32ValueToScaleConverter}}"
                        ScaleY="{
                                Binding DataContext.InformationBarVm.SelectedScalePercentage.Value,
                                RelativeSource={RelativeSource AncestorType=Window},
                                Converter={StaticResource Int32ValueToScaleConverter}}"
                    />
                </local:ReservationEquipDailyGrid.LayoutTransform>
            </local:ReservationEquipDailyGrid>-->


            <materialDesign:Snackbar
                x:Name="Snackbar"
                Grid.Row="0"
                Grid.RowSpan="4"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                MessageQueue="{Binding SnackbarMessageQueue}" />
        </Grid>
    </DockPanel>
</Window>
