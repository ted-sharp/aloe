<UserControl
    x:Class="Aloe.Medock.Reservation.AloeMedockResvApp.Views.Resv.ReservationDailyGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bhv="http://schemas.aloe/wpf/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.ViewModels"
    d:Background="Azure"
    d:DataContext="{d:DesignInstance Type=vm:ReservationEquipTabItemViewModel}"
    d:DesignHeight="500"
    d:DesignWidth="720"
    DataContextChanged="ReservationDailyGrid_OnDataContextChanged"
    mc:Ignorable="d">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="HeaderGlossBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.0" Color="#FFFFFF" />
            <GradientStop Offset="0.4" Color="#FFFFFF" />
            <GradientStop Offset="0.5" Color="#F6F7F9" />
            <GradientStop Offset="0.7" Color="#F4F5F7" />
            <GradientStop Offset="1.0" Color="#F2F3F5" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RowHeaderGlossBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0.0" Color="#FFFFFF" />
            <GradientStop Offset="0.3" Color="#FFFFFF" />
            <GradientStop Offset="0.4" Color="#F6F7F9" />
            <GradientStop Offset="0.7" Color="#F4F5F7" />
            <GradientStop Offset="1.0" Color="#F2F3F5" />
        </LinearGradientBrush>

        <Style x:Key="ColumnHeaderLabel" TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource HeaderGlossBrush}" />
        </Style>
        <Style x:Key="RowHeaderLabel" TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource RowHeaderGlossBrush}" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
            <Grid x:Name="BookingGrid">
                <Grid.ColumnDefinitions>
                    <!--  ローヘッダー、全、Room1、Room2、...  -->
                    <!--  ローヘッダー、全、カテゴリ1、カテゴリ2、...  -->
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <!--  カラムヘッダー、日計、AM、PM、Slot1、Slot2、...  -->
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  ローヘッダー、全、Room1、Room2、...  -->
                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource ColumnHeaderLabel}">
                    12/31 (土)
                </Label>
                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource ColumnHeaderLabel}">
                    全
                </Label>
                <Label
                    Grid.Row="0"
                    Grid.Column="2"
                    Style="{StaticResource ColumnHeaderLabel}">
                    眼底
                </Label>
                <Label
                    Grid.Row="0"
                    Grid.Column="3"
                    Style="{StaticResource ColumnHeaderLabel}">
                    肺機能
                </Label>
                <Label
                    Grid.Row="0"
                    Grid.Column="4"
                    Style="{StaticResource ColumnHeaderLabel}">
                    心電図
                </Label>
                <Label
                    Grid.Row="0"
                    Grid.Column="5"
                    Style="{StaticResource ColumnHeaderLabel}">
                    ABI
                </Label>
                <Label
                    Grid.Row="0"
                    Grid.Column="6"
                    Style="{StaticResource ColumnHeaderLabel}">
                    胃部X線
                </Label>
                <Label
                    Grid.Row="0"
                    Grid.Column="7"
                    Style="{StaticResource ColumnHeaderLabel}">
                    胃部内視鏡
                </Label>
                <Label
                    Grid.Row="0"
                    Grid.Column="8"
                    Style="{StaticResource ColumnHeaderLabel}">
                    腹部エコー
                </Label>
                <Label
                    Grid.Row="0"
                    Grid.Column="9"
                    Style="{StaticResource ColumnHeaderLabel}">
                    マンモ
                </Label>
                <Label
                    Grid.Row="0"
                    Grid.Column="10"
                    Style="{StaticResource ColumnHeaderLabel}">
                    乳腺エコー
                </Label>
                <Label
                    Grid.Row="0"
                    Grid.Column="11"
                    Style="{StaticResource ColumnHeaderLabel}">
                    婦人科エコー
                </Label>
                <Label
                    Grid.Row="0"
                    Grid.Column="12"
                    Style="{StaticResource ColumnHeaderLabel}">
                    子宮細胞診
                </Label>
                <Label
                    Grid.Row="0"
                    Grid.Column="13"
                    Style="{StaticResource ColumnHeaderLabel}">
                    MR
                </Label>
                <Label
                    Grid.Row="0"
                    Grid.Column="14"
                    Style="{StaticResource ColumnHeaderLabel}">
                    CT
                </Label>
                <Label
                    Grid.Row="0"
                    Grid.Column="15"
                    Style="{StaticResource ColumnHeaderLabel}">
                    VDT
                </Label>

                <!--  カラムヘッダー、日計、AM、PM、Slot1、Slot2、...  -->
                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource RowHeaderLabel}">
                    日計
                </Label>
                <Label
                    Grid.Row="2"
                    Grid.Column="0"
                    Style="{StaticResource RowHeaderLabel}">
                    AM
                </Label>
                <Label
                    Grid.Row="3"
                    Grid.Column="0"
                    Style="{StaticResource RowHeaderLabel}">
                    PM
                </Label>
                <Label
                    Grid.Row="4"
                    Grid.Column="0"
                    Style="{StaticResource RowHeaderLabel}">
                    08:15
                </Label>
                <Label
                    Grid.Row="5"
                    Grid.Column="0"
                    Style="{StaticResource RowHeaderLabel}">
                    08:30
                </Label>
                <Label
                    Grid.Row="6"
                    Grid.Column="0"
                    Style="{StaticResource RowHeaderLabel}">
                    09:00
                </Label>
                <Label
                    Grid.Row="7"
                    Grid.Column="0"
                    Style="{StaticResource RowHeaderLabel}">
                    09:30
                </Label>
                <Label
                    Grid.Row="8"
                    Grid.Column="0"
                    Style="{StaticResource RowHeaderLabel}">
                    10:00
                </Label>
                <Label
                    Grid.Row="9"
                    Grid.Column="0"
                    Style="{StaticResource RowHeaderLabel}">
                    10:30
                </Label>
                <Label
                    Grid.Row="10"
                    Grid.Column="0"
                    Style="{StaticResource RowHeaderLabel}">
                    11:00
                </Label>
                <Label
                    Grid.Row="11"
                    Grid.Column="0"
                    Style="{StaticResource RowHeaderLabel}">
                    11:30
                </Label>
                <Label
                    Grid.Row="12"
                    Grid.Column="0"
                    Style="{StaticResource RowHeaderLabel}">
                    13:00
                </Label>
                <Label
                    Grid.Row="13"
                    Grid.Column="0"
                    Style="{StaticResource RowHeaderLabel}">
                    13:30
                </Label>
                <Label
                    Grid.Row="14"
                    Grid.Column="0"
                    Style="{StaticResource RowHeaderLabel}">
                    14:00
                </Label>
                <Label
                    Grid.Row="15"
                    Grid.Column="0"
                    Style="{StaticResource RowHeaderLabel}">
                    14:30
                </Label>
                <Label
                    Grid.Row="16"
                    Grid.Column="0"
                    Style="{StaticResource RowHeaderLabel}">
                    15:00
                </Label>
                <Label
                    Grid.Row="17"
                    Grid.Column="0"
                    Style="{StaticResource RowHeaderLabel}">
                    15:30
                </Label>
                <Label
                    Grid.Row="18"
                    Grid.Column="0"
                    Style="{StaticResource RowHeaderLabel}">
                    16:00
                </Label>
                <Label
                    Grid.Row="19"
                    Grid.Column="0"
                    Style="{StaticResource RowHeaderLabel}">
                    16:30
                </Label>

                <!--  内容  -->
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    bhv:OnSelected.EnableSelectionAdorner="True"
                    BorderThickness="1">
                    <Label Content="1/99" />
                </Border>
                <Border
                    Grid.Row="2"
                    Grid.Column="1"
                    bhv:OnSelected.EnableSelectionAdorner="True"
                    BorderThickness="1">

                    <Label Content="2/99" />
                </Border>
                <Border
                    Grid.Row="3"
                    Grid.Column="1"
                    bhv:OnSelected.EnableSelectionAdorner="True"
                    BorderThickness="1">
                    <Label Content="3/99" />
                </Border>
                <Border
                    Grid.Row="5"
                    Grid.RowSpan="4"
                    Grid.Column="1"
                    bhv:OnSelected.EnableSelectionAdorner="True"
                    Background="Bisque"
                    BorderBrush="Black"
                    BorderThickness="1">
                    <Label>
                        99/99
                    </Label>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
