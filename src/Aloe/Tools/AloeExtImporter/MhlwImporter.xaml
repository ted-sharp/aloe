<UserControl
    x:Class="AloeExtImporter.MhlwImporter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AloeExtImporter"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Background="DarkOliveGreen"
    d:DesignHeight="480"
    d:DesignWidth="640"
    Loaded="MhlwImporter_OnLoaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="1" />
        </Style>
    </UserControl.Resources>

    <StackPanel d:Margin="4">
        <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}" Text="厚生労働省 第４期（2024年度～2029年度分） XML用特定健診項目情報" />

        <StackPanel Margin="0,20">
            <TextBlock Margin="0,0,0,5" Text="XML用特定健診項目情報: 500件" />
            <TextBlock Margin="0,0,0,0" Text="ダウンロードページ - 付属２: XML用特定健診項目情報" />
            <TextBlock>
                <Hyperlink NavigateUri="https://www.mhlw.go.jp/stf/seisakunitsuite/bunya/xml_30799.html" RequestNavigate="Hyperlink_RequestNavigate">
                    https://www.mhlw.go.jp/stf/seisakunitsuite/bunya/xml_30799.html
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="100" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="120" />
                <ColumnDefinition Width="Auto" MinWidth="120" />
            </Grid.ColumnDefinitions>
            <Label
                Grid.Column="0"
                HorizontalAlignment="Right"
                Content="作業ディレクトリ" />
            <TextBox
                x:Name="WorkTextBox"
                Grid.Column="1"
                materialDesign:HintAssist.Hint="./tmp/"
                materialDesign:TextFieldAssist.HasFilledTextField="True"
                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                materialDesign:TextFieldAssist.LeadingIcon="Folder"
                Style="{StaticResource MaterialDesignTextBox}"
                Text="./tmp/" />
            <Button
                Grid.Column="2"
                Width="100"
                Margin="10,0"
                Click="BrowseWorkButton_OnClick"
                Content="選択..."
                Style="{StaticResource MaterialDesignRaisedButton}" />
            <Button
                Grid.Column="3"
                Width="100"
                Margin="10,0"
                Click="OpenWorkButton_OnClick"
                Content="開く..."
                Style="{StaticResource MaterialDesignRaisedButton}" />
        </Grid>

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="100" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="120" />
                <ColumnDefinition Width="Auto" MinWidth="120" />
            </Grid.ColumnDefinitions>
            <Label
                Grid.Column="0"
                HorizontalAlignment="Right"
                Content="EXCELファイル" />
            <TextBox
                x:Name="MhlwTextBox"
                Grid.Column="1"
                materialDesign:HintAssist.Hint="第４期: 001082795.xlsx"
                materialDesign:TextFieldAssist.HasClearButton="True"
                materialDesign:TextFieldAssist.HasFilledTextField="True"
                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                materialDesign:TextFieldAssist.LeadingIcon="FileExcel"
                Style="{StaticResource MaterialDesignTextBox}"
                Text="./tmp/001082795.xlsx" />
            <Button
                Grid.Column="2"
                Width="100"
                Margin="10,0"
                Click="OpenMhlwButton_OnClick"
                Content="選択..."
                Style="{StaticResource MaterialDesignRaisedButton}" />
            <Button
                Grid.Column="3"
                Width="100"
                Margin="10,0"
                Click="ImportButton_OnClick"
                Content="インポート"
                Style="{StaticResource MaterialDesignRaisedButton}" />
        </Grid>

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="120" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="1" Content="別途ダウンロードして作業ディレクトリにおいてください。" />
            <TextBlock
                x:Name="MhlwDownloadStatusTextBlock"
                Grid.Column="2"
                Width="100"
                Text="未処理" />
        </Grid>

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="100" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="120" />
            </Grid.ColumnDefinitions>
            <Label
                Grid.Column="0"
                HorizontalAlignment="Right"
                Content="インポート" />
            <ProgressBar
                x:Name="MhlwImportProgressBar"
                Grid.Column="1"
                Height="20"
                IsIndeterminate="False"
                Maximum="100"
                Minimum="0"
                Value="0" />
            <TextBlock
                x:Name="MhlwImportStatusTextBlock"
                Grid.Column="2"
                Width="100"
                Text="未処理" />
        </Grid>

    </StackPanel>
</UserControl>
