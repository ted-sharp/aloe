<UserControl
    x:Class="AloeExtImporter.HoujinImporter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AloeExtImporter"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Background="DarkTurquoise"
    d:DesignHeight="480"
    d:DesignWidth="640"
    mc:Ignorable="d"
    Loaded="HoujinImporter_OnLoaded">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="1" />
        </Style>
    </UserControl.Resources>

    <StackPanel d:Margin="4">
        <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}" Text="国税庁 法人番号 基本３情報/JIS縮退マップ" />

        <StackPanel Margin="0,20">
            <TextBlock Margin="0,0,0,5" Text="法人番号: 600万件 1GB程度" />
            <TextBlock Margin="0,0,0,5" Text="JIS縮退マップ: 12万件 1MB程度" />
            <TextBlock Margin="0,0,0,5" Text="ダウンロードページ" />
            <TextBlock>
                <Hyperlink NavigateUri="https://www.houjin-bangou.nta.go.jp/download/" RequestNavigate="Hyperlink_RequestNavigate">
                    https://www.houjin-bangou.nta.go.jp/download/
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Width="100"
                Text="作業ディレクトリ" />
            <TextBox
                x:Name="WorkTextBox"
                Grid.Column="1"
                materialDesign:HintAssist.Hint="作業用フォルダ"
                Text="./tmp/" />
            <Button
                Grid.Column="2"
                Width="100"
                Margin="10,0"
                Click="OpenWorkButton_OnClick"
                Content="選択..."
                Style="{StaticResource MaterialDesignRaisedButton}" />
        </Grid>

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Width="100"
                Text="法人CSVファイル" />
            <TextBox
                x:Name="HoujinTextBox"
                Grid.Column="1"
                materialDesign:HintAssist.Hint="作業用フォルダ"
                Text="./tmp/00_zenkoku_all_yyyyMMdd.zip" />
            <Button
                Grid.Column="2"
                Width="100"
                Margin="10,0"
                Click="OpenHoujinButton_OnClick"
                Content="選択..."
                Style="{StaticResource MaterialDesignRaisedButton}" />
        </Grid>

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Width="100"
                Text="JIS縮退マップ" />
            <TextBox
                x:Name="JisDownloadUrlTextBox"
                Grid.Column="1"
                Text="https://www.houjin-bangou.nta.go.jp/pc/download/images/jissyukutaimap1_0_0.xlsx" />
            <Button
                Grid.Column="2"
                Width="100"
                Margin="10,0"
                Click="DownloadJisButton_OnClick"
                Content="ダウンロード"
                Style="{StaticResource MaterialDesignRaisedButton}" />
        </Grid>

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar
                x:Name="ProgressBar"
                Grid.Column="0"
                Height="20"
                IsIndeterminate="False"
                Maximum="100"
                Minimum="0"
                Value="0" />
            <Button
                Grid.Column="1"
                Width="100"
                Margin="10,0"
                Click="ImportHoujinButton_OnClick"
                Content="インポート"
                Style="{StaticResource MaterialDesignRaisedButton}" />
        </Grid>

    </StackPanel>
</UserControl>
