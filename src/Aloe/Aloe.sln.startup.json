/*
    This is a configuration file for the SwitchStartupProject Visual Studio Extension
    See https://heptapod.host/thirteen/switchstartupproject/blob/branch/current/Configuration.md
*/
{
  /*  Configuration File Version  */
  "Version": 3,

  /*  Create an item in the dropdown list for each project in the solution?  */
  "ListAllProjects": false,

  /*
        Dictionary of named configurations with one or multiple startup projects
        and optional parameters like command line arguments and working directory.
        Example:

        "MultiProjectConfigurations": {
          "A + B (Ext)": {
            "Projects": {
              "MyProjectA": {},
              "MyProjectB": {
                "CommandLineArguments": "1234",
                "WorkingDirectory": "%USERPROFILE%\\test",
                "StartExternalProgram": "c:\\myprogram.exe"
              }
            }
          },
          "A + B": {
            "Projects": {
              "MyProjectA": {},
              "MyProjectB": {
                "CommandLineArguments": "",
                "WorkingDirectory": "",
                "StartProject": true
              }
            }
          },
          "D (Debug x86)": {
            "Projects": {
              "MyProjectD": {}
            },
            "SolutionConfiguration": "Debug",
            "SolutionPlatform": "x86",
          },
          "D (Release x64)": {
            "Projects": {
              "MyProjectD": {}
            },
            "SolutionConfiguration": "Release",
            "SolutionPlatform": "x64",
          }
        }
    */
  "MultiProjectConfigurations": {
    "App(Standalone)": {
      "Projects": {
        "AloeMedockResvApp": {
          "CommandLineArguments": "--standalone --sql",
          "WorkingDirectory": "",
          "StartProject": true
        }
      }
    },

    "App(Standalone login)": {
      "Projects": {
        "AloeMedockResvApp": {
          "CommandLineArguments": "--standalone -u admin -p admin",
          "WorkingDirectory": "",
          "StartProject": true
        }
      }
    },

    "App(Standalone login Equip)": {
      "Projects": {
        "AloeMedockResvApp": {
          "CommandLineArguments": "--standalone --user=admin --pwd=admin --screen=4 ",
          "WorkingDirectory": "",
          "StartProject": true
        }
      }
    },

    "Trace App(Standalone login Equip)": {
      "Projects": {
        "AloeMedockResvApp": {
          "StartExternalProgram": "C:\\Program Files\\dotnet\\dotnet.exe",
          "CommandLineArguments": "trace collect --format speedscope --output \"$(TargetDir)$(ProjectName).nettrace\" -- $(TargetDir)$(ProjectName).exe --standalone --user=admin --pwd=admin --screen=4",
          // https://www.speedscope.app
          // https://github.com/jlfwong/speedscope#usage
          "WorkingDirectory": "$(TargetDir)"
        }
      }
    },

    "App(Standalone login Daily)": {
      "Projects": {
        "AloeMedockResvApp": {
          "CommandLineArguments": "--standalone -uadmin -padmin --screen=6 ",
          "WorkingDirectory": "",
          "StartProject": true
        }
      }
    },

    "App(Standalone login Org)": {
      "Projects": {
        "AloeMedockResvApp": {
          "CommandLineArguments": "--standalone --user=admin --pwd=admin --screen=9 ",
          "WorkingDirectory": "",
          "StartProject": true
        }
      }
    },

    "App(Standalone login Pt)": {
      "Projects": {
        "AloeMedockResvApp": {
          "CommandLineArguments": "--standalone --user=admin --pwd=admin --screen=10 ",
          "WorkingDirectory": "",
          "StartProject": true
        }
      }
    },

    "Svr + App": {
      "Projects": {
        "AloeMedockResvServer": {
          "CommandLineArguments": "",
          "WorkingDirectory": ""
        },
        "AloeMedockResvApp": {
          "CommandLineArguments": "",
          "WorkingDirectory": "",
          "StartProject": true
        }
      }
    },

    "Monitor": {
      "Projects": {
        "AloeMedockResvServerMonitor": {
          "CommandLineArguments": "",
          "WorkingDirectory": "",
          "StartProject": true
        }
      }
    },

    "Seed": {
      "Projects": {
        "AloeMedockResvServer": {
          "CommandLineArguments": "--seed",
          "WorkingDirectory": "",
          "StartProject": true
        }
      }
    },

    "Ext": {
      "Projects": {
        "AloeExtImporter": {
          "CommandLineArguments": "",
          "WorkingDirectory": "",
          "StartProject": true
        }
      }
    },

    "SOAP": {
      "Projects": {
        "AloeSoapSample": {
          "CommandLineArguments": "",
          "WorkingDirectory": "",
          "StartProject": true
        }
      }
    },

    "SSMIX": {
      "Projects": {
        "AloeSsmixSample": {
          "CommandLineArguments": "",
          "WorkingDirectory": "",
          "StartProject": true
        }
      }
    }

  }
}
