@* カレンダー専用フルスクリーンレイアウト *@
@inherits LayoutComponentBase
@using Aloe.Apps.MedockServer.Components.FAB

<div class="calendar-fullscreen calendar-container bg-base-200">
    <CascadingValue Value="this">
        @Body
    </CascadingValue>

    <!-- ActionFab（右下固定） -->
    <ActionFab CurrentView="@CurrentView"
               OnNewAppointment="HandleNewAppointment"
               OnToggleFilter="HandleToggleFilter"
               OnGoToToday="HandleGoToToday"
               OnPreviousPeriod="HandlePreviousPeriod"
               OnNextPeriod="HandleNextPeriod"
               OnViewChange="HandleViewChange" />

    <!-- ナビゲーションドロワー -->
    @if (IsDrawerOpen)
    {
        <NavigationDrawer IsOpen="@IsDrawerOpen" OnClose="CloseDrawer" />
    }
</div>

<!-- エラー表示 -->
<div id="blazor-error-ui" class="fixed bottom-0 left-0 right-0 z-[1100] hidden" data-nosnippet>
    <div class="alert alert-error shadow-lg m-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>エラーが発生しました。</span>
        <div>
            <a href="." class="btn btn-sm btn-ghost">再読み込み</a>
            <button class="btn btn-sm btn-ghost dismiss">閉じる</button>
        </div>
    </div>
</div>

@code {
    // ドロワー状態（Calendar.razorから参照される）
    private bool _isDrawerOpen;
    public bool IsDrawerOpen
    {
        get => _isDrawerOpen;
        set
        {
            if (_isDrawerOpen != value)
            {
                _isDrawerOpen = value;
                StateHasChanged();
            }
        }
    }

    // カレンダーからの状態
    public string CurrentView { get; private set; } = "month";

    // カレンダーからのコールバック
    private Func<Task>? _onNewAppointment;
    private Func<Task>? _onToggleFilter;
    private Func<Task>? _onGoToToday;
    private Func<Task>? _onPreviousPeriod;
    private Func<Task>? _onNextPeriod;
    private Func<string, Task>? _onViewChange;

    /// <summary>
    /// カレンダーページからアクションを登録する
    /// </summary>
    public void RegisterCalendarActions(
        string currentView,
        Func<Task>? onNewAppointment = null,
        Func<Task>? onToggleFilter = null,
        Func<Task>? onGoToToday = null,
        Func<Task>? onPreviousPeriod = null,
        Func<Task>? onNextPeriod = null,
        Func<string, Task>? onViewChange = null)
    {
        CurrentView = currentView;
        _onNewAppointment = onNewAppointment;
        _onToggleFilter = onToggleFilter;
        _onGoToToday = onGoToToday;
        _onPreviousPeriod = onPreviousPeriod;
        _onNextPeriod = onNextPeriod;
        _onViewChange = onViewChange;
        StateHasChanged();
    }

    /// <summary>
    /// 現在のビューを更新する
    /// </summary>
    public void UpdateCurrentView(string view)
    {
        CurrentView = view;
        StateHasChanged();
    }

    private void CloseDrawer()
    {
        IsDrawerOpen = false;
    }

    private async Task HandleNewAppointment()
    {
        if (_onNewAppointment != null)
        {
            await _onNewAppointment();
        }
    }

    private async Task HandleToggleFilter()
    {
        if (_onToggleFilter != null)
        {
            await _onToggleFilter();
        }
    }

    private async Task HandleGoToToday()
    {
        if (_onGoToToday != null)
        {
            await _onGoToToday();
        }
    }

    private async Task HandlePreviousPeriod()
    {
        if (_onPreviousPeriod != null)
        {
            await _onPreviousPeriod();
        }
    }

    private async Task HandleNextPeriod()
    {
        if (_onNextPeriod != null)
        {
            await _onNextPeriod();
        }
    }

    private async Task HandleViewChange(string view)
    {
        if (_onViewChange != null)
        {
            await _onViewChange(view);
        }
    }
}
