@* カレンダー専用フルスクリーンレイアウト *@
@inherits LayoutComponentBase
@using Aloe.Apps.MedockLib.Services
@using Aloe.Apps.MedockServer.Components.FAB
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject NavigationManager NavigationManager
@inject AuthService AuthService
@inject ProtectedLocalStorage LocalStorage
@inject AuthenticationStateProvider AuthStateProvider

<div class="calendar-fullscreen calendar-container bg-base-200">
    <CascadingValue Value="this">
        @Body
    </CascadingValue>

    <!-- FABレイヤー -->
    <HamburgerFab @bind-IsDrawerOpen="IsDrawerOpen" />
    <UserAvatarFab UserInitial="@UserInitial"
                   UserName="@UserName"
                   UserEmail="@UserEmail"
                   TenantName="@TenantName"
                   UserRole="@UserRole"
                   OnLogout="HandleLogout" />
    <ActionFab CurrentView="@CurrentView"
               OnNewAppointment="HandleNewAppointment"
               OnToggleFilter="HandleToggleFilter"
               OnGoToToday="HandleGoToToday"
               OnPreviousPeriod="HandlePreviousPeriod"
               OnNextPeriod="HandleNextPeriod"
               OnViewChange="HandleViewChange" />

    <!-- ナビゲーションドロワー -->
    @if (IsDrawerOpen)
    {
        <NavigationDrawer IsOpen="@IsDrawerOpen" OnClose="CloseDrawer" />
    }
</div>

<!-- エラー表示 -->
<div id="blazor-error-ui" class="fixed bottom-0 left-0 right-0 z-[1100] hidden" data-nosnippet>
    <div class="alert alert-error shadow-lg m-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>エラーが発生しました。</span>
        <div>
            <a href="." class="btn btn-sm btn-ghost">再読み込み</a>
            <button class="btn btn-sm btn-ghost dismiss">閉じる</button>
        </div>
    </div>
</div>

@code {
    private bool IsDrawerOpen { get; set; }
    private string UserInitial { get; set; } = "U";
    private string UserName { get; set; } = "";
    private string UserEmail { get; set; } = "";
    private string TenantName { get; set; } = "";
    private string UserRole { get; set; } = "";

    // カレンダーからの状態
    public string CurrentView { get; private set; } = "month";

    protected override async Task OnInitializedAsync()
    {
        await LoadUserInfoAsync();
    }

    private async Task LoadUserInfoAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                UserName = user.FindFirst("name")?.Value
                    ?? user.FindFirst("user_name")?.Value
                    ?? user.Identity.Name
                    ?? "";

                UserEmail = user.FindFirst("email")?.Value ?? "";
                TenantName = user.FindFirst("tenant_name")?.Value ?? "";

                var roles = user.FindAll("role").Select(c => c.Value).ToList();
                UserRole = roles.FirstOrDefault() ?? "";

                if (!string.IsNullOrEmpty(UserName))
                {
                    UserInitial = UserName[..1].ToUpper();
                }
            }
        }
        catch
        {
            // ユーザー情報取得失敗時は初期値のまま
        }
    }

    // カレンダーからのコールバック
    private Func<Task>? _onNewAppointment;
    private Func<Task>? _onToggleFilter;
    private Func<Task>? _onGoToToday;
    private Func<Task>? _onPreviousPeriod;
    private Func<Task>? _onNextPeriod;
    private Func<string, Task>? _onViewChange;

    /// <summary>
    /// カレンダーページからアクションを登録する
    /// </summary>
    public void RegisterCalendarActions(
        string currentView,
        Func<Task>? onNewAppointment = null,
        Func<Task>? onToggleFilter = null,
        Func<Task>? onGoToToday = null,
        Func<Task>? onPreviousPeriod = null,
        Func<Task>? onNextPeriod = null,
        Func<string, Task>? onViewChange = null)
    {
        CurrentView = currentView;
        _onNewAppointment = onNewAppointment;
        _onToggleFilter = onToggleFilter;
        _onGoToToday = onGoToToday;
        _onPreviousPeriod = onPreviousPeriod;
        _onNextPeriod = onNextPeriod;
        _onViewChange = onViewChange;
        StateHasChanged();
    }

    /// <summary>
    /// 現在のビューを更新する
    /// </summary>
    public void UpdateCurrentView(string view)
    {
        CurrentView = view;
        StateHasChanged();
    }

    private void CloseDrawer()
    {
        IsDrawerOpen = false;
    }

    private async Task HandleNewAppointment()
    {
        if (_onNewAppointment != null)
        {
            await _onNewAppointment();
        }
    }

    private async Task HandleToggleFilter()
    {
        if (_onToggleFilter != null)
        {
            await _onToggleFilter();
        }
    }

    private async Task HandleGoToToday()
    {
        if (_onGoToToday != null)
        {
            await _onGoToToday();
        }
    }

    private async Task HandlePreviousPeriod()
    {
        if (_onPreviousPeriod != null)
        {
            await _onPreviousPeriod();
        }
    }

    private async Task HandleNextPeriod()
    {
        if (_onNextPeriod != null)
        {
            await _onNextPeriod();
        }
    }

    private async Task HandleViewChange(string view)
    {
        if (_onViewChange != null)
        {
            await _onViewChange(view);
        }
    }

    private async Task HandleLogout()
    {
        try
        {
            // セッションIDを取得してログアウトAPIを呼び出す
            var sessionIdResult = await LocalStorage.GetAsync<string>("session_id");
            if (sessionIdResult.Success && !string.IsNullOrEmpty(sessionIdResult.Value))
            {
                if (Guid.TryParse(sessionIdResult.Value, out var sessionId))
                {
                    await AuthService.LogoutAsync(sessionId);
                }
            }
        }
        catch
        {
            // ログアウトAPIの失敗は無視
        }
        finally
        {
            // ローカルストレージをクリア
            try
            {
                await LocalStorage.DeleteAsync("session_id");
                await LocalStorage.DeleteAsync("keep_session");
                await LocalStorage.DeleteAsync("access_token");
                await LocalStorage.DeleteAsync("remember_user_code");
            }
            catch
            {
                // ストレージクリア失敗も無視
            }

            // ログインページにリダイレクト
            NavigationManager.NavigateTo("/login", forceLoad: true);
        }
    }
}
