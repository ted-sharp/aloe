@* カレンダー専用フルスクリーンレイアウト *@
@inherits LayoutComponentBase
@using Aloe.Apps.MedockServer.Components.FAB
@using Aloe.Apps.MedockServer.Components.Voice

<div class="calendar-fullscreen calendar-container bg-base-200">
    <CascadingValue Value="this">
        @Body
    </CascadingValue>

    <!-- 音声コマンドボタン（右下固定） -->
    <VoiceCommandButton OnCommandReady="HandleVoiceCommand" />

    <!-- ナビゲーションドロワー -->
    @if (IsDrawerOpen)
    {
        <NavigationDrawer IsOpen="@IsDrawerOpen" OnClose="CloseDrawer" />
    }
</div>

<!-- エラー表示 -->
<div id="blazor-error-ui" class="fixed bottom-0 left-0 right-0 z-[1100] hidden" data-nosnippet>
    <div class="alert alert-error shadow-lg m-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>エラーが発生しました。</span>
        <div>
            <a href="." class="btn btn-sm btn-ghost">再読み込み</a>
            <button class="btn btn-sm btn-ghost dismiss">閉じる</button>
        </div>
    </div>
</div>

