<!DOCTYPE html>
<html lang="ja" data-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Aloe Medock</title>
    <ResourcePreloader />
    
    <!-- Google Fonts: M PLUS Rounded 1c + Playwrite Norge -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@100;300;400;500;700;800;900&family=Playwrite+Norge:wght@100..400&display=swap" rel="stylesheet">
    
    <!-- daisyUI v5 + Tailwind CSS v4 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/daisyui@@5" rel="stylesheet" type="text/css" />
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4"></script>
    
    <!-- D3.js for calculations -->
    <script src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js"></script>
    <!-- Konva.js for Canvas rendering -->
    <script src="https://cdn.jsdelivr.net/npm/konva@10/konva.min.js"></script>
    <!-- SignalR Client for real-time updates -->
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@latest/dist/browser/signalr.min.js"></script>
    
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="css/layout.css" />
    <link rel="stylesheet" href="css/calendar.css" />
    <link rel="stylesheet" href="@Assets["Aloe.Apps.MedockServer.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

@using Microsoft.AspNetCore.Components.Web

<body class="h-full w-full overflow-hidden bg-base-200">
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="loginApi.js"></script>
    <script type="module" src="js/calendar/calendar-main.js"></script>
</body>

</html>
