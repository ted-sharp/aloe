@* 週表示コンポーネント *@

<div class="overflow-x-auto">
    <!-- 曜日ヘッダー -->
    <div class="grid grid-cols-8 bg-base-200 sticky top-0 z-10">
        <div class="p-2 border-b border-r border-base-300"></div>
        @{
            var startOfWeek = CurrentDate.AddDays(-(int)CurrentDate.DayOfWeek);
            var today = DateOnly.FromDateTime(DateTime.Today);
        }
        @for (int i = 0; i < 7; i++)
        {
            var date = startOfWeek.AddDays(i);
            var isToday = date == today;
            var dayName = new[] { "日", "月", "火", "水", "木", "金", "土" }[i];
            var textColor = i == 0 ? "text-error" : i == 6 ? "text-info" : "";

            <div class="p-2 text-center border-b border-r border-base-300 @textColor @(isToday ? "bg-primary/10" : "")">
                <div class="font-semibold">@dayName</div>
                <div class="@(isToday ? "badge badge-primary" : "")">@date.Day</div>
            </div>
        }
    </div>

    <!-- 時間グリッド -->
    <div class="min-h-[600px]">
        @for (int hour = 8; hour <= 18; hour++)
        {
            <div class="grid grid-cols-8 border-b border-base-300">
                <!-- 時間ラベル -->
                <div class="p-2 text-right text-sm text-base-content/60 border-r border-base-300 sticky left-0 bg-base-100">
                    @hour:00
                </div>

                <!-- 各曜日のスロット -->
                @for (int day = 0; day < 7; day++)
                {
                    var date = startOfWeek.AddDays(day);
                    var dateTime = date.ToDateTime(new TimeOnly(hour, 0));
                    var hasAppointment = GetSampleHourAppointments(date, hour).Any();

                    <div class="p-1 min-h-[60px] border-r border-base-300 hover:bg-base-200 cursor-pointer transition-colors"
                         @onclick="() => OnTimeSlotClick.InvokeAsync(dateTime)">
                        @foreach (var appt in GetSampleHourAppointments(date, hour))
                        {
                            <div class="text-xs p-1 mb-1 rounded @GetStatusClass(appt.Status)">
                                <div class="font-semibold">@appt.Name</div>
                                <div class="opacity-75">@appt.Org</div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public DateOnly CurrentDate { get; set; }

    [Parameter]
    public EventCallback<DateTime> OnTimeSlotClick { get; set; }

    // サンプルデータ
    private IEnumerable<(string Name, string Org, int Status)> GetSampleHourAppointments(DateOnly date, int hour)
    {
        var hash = (date.GetHashCode() + hour) % 10;
        if (hash < 3) yield break;

        var names = new[] { "山田 太郎", "佐藤 花子", "鈴木 一郎" };
        var orgs = new[] { "ABC商事", "XYZ工業", "個人" };

        if (hash > 6)
        {
            yield return (names[hash % 3], orgs[hash % 3], hash % 4);
        }
        if (hash > 8)
        {
            yield return (names[(hash + 1) % 3], orgs[(hash + 1) % 3], (hash + 1) % 4);
        }
    }

    private string GetStatusClass(int status)
    {
        return status switch
        {
            0 => "bg-warning/20 border-l-4 border-warning",
            1 => "bg-info/20 border-l-4 border-info",
            2 => "bg-success/20 border-l-4 border-success",
            3 => "bg-error/20 border-l-4 border-error",
            _ => "bg-base-200"
        };
    }
}

