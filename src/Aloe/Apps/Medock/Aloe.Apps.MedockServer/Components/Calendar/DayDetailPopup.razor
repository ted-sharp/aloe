@* 日付詳細ポップアップ - 通常予約を表示 *@
@* EquipmentはAppointmentResourceに統合されました *@

@if (IsOpen)
{
    <div class="modal modal-open">
        <!-- 背景ぼかし -->
        <div class="modal-backdrop backdrop-blur-sm bg-black/30" @onclick="HandleClose"></div>

        <div class="modal-box max-w-4xl h-[80vh] overflow-hidden flex flex-col">
            <!-- ヘッダー -->
            <div class="flex items-center justify-between mb-4">
                <h3 class="font-bold text-lg">
                    @if (SelectedDate.HasValue)
                    {
                        @SelectedDate.Value.ToString("yyyy年MM月dd日 (ddd)")
                    }
                </h3>
                <button class="btn btn-sm btn-circle btn-ghost" @onclick="HandleClose">✕</button>
            </div>

            <div class="flex-1 overflow-hidden">
                <!-- 通常予約の横棒グラフ -->
                <div class="flex flex-col overflow-hidden">
                    <h4 class="font-semibold mb-2">通常予約</h4>
                    <div class="overflow-y-auto space-y-3">
                        @if (MainStats != null && MainStats.Any())
                        {
                            @foreach (var slot in GetSlotsFromStats())
                            {
                                // 空き率を計算（1 - 使用率）
                                var vacancyRatio = slot.Cap > 0 ? (1 - slot.Count / (double)slot.Cap) * 100 : 0;
                                // 空き率が0%より大きい場合のみ表示
                                if (vacancyRatio > 0)
                                {
                                    var color = GetBarColor(vacancyRatio);

                                    <div>
                                        <div class="flex justify-between text-sm mb-1">
                                            <span class="font-medium">@slot.Time</span>
                                            <span>@slot.Count/@slot.Cap (空き:@Math.Round(vacancyRatio)%)</span>
                                        </div>
                                        <div class="bg-base-200 h-6 rounded overflow-hidden">
                                            <div class="h-full transition-all vacancy-bar"
                                                 style="--bar-width: @(vacancyRatio)%; --bar-color: @color;"></div>
                                        </div>
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <div class="text-center text-base-content/60 py-8">
                                データがありません
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- フッター -->
            <div class="modal-action">
                <button class="btn btn-ghost" @onclick="HandleClose">閉じる</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public DateOnly? SelectedDate { get; set; }
    [Parameter] public List<Aloe.Apps.MedockLib.Data.Entities.AppointmentStats>? MainStats { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    // Equipment関連のパラメータとメソッドは削除されました（AppointmentResourceに統合）

    private List<TimeSlotStats> GetSlotsFromStats()
    {
        if (MainStats == null || !MainStats.Any())
            return new List<TimeSlotStats>();

        // 時間範囲をキーとして使用（"HH:mm-HH:mm"形式）
        var slotMap = new Dictionary<string, (TimeOnly Start, TimeOnly End, int Count, int Cap)>();

        foreach (var stat in MainStats)
        {
            try
            {
                var graphData = System.Text.Json.JsonSerializer.Deserialize<GraphDefinition>(stat.ApptGraph);
                if (graphData?.Slots != null)
                {
                    foreach (var slot in graphData.Slots)
                    {
                        var timeRangeKey = $"{slot.Start:HH:mm}-{slot.End:HH:mm}";
                        if (slotMap.ContainsKey(timeRangeKey))
                        {
                            var existing = slotMap[timeRangeKey];
                            slotMap[timeRangeKey] = (existing.Start, existing.End, existing.Count + slot.Count, existing.Cap + slot.Cap);
                        }
                        else
                        {
                            slotMap[timeRangeKey] = (slot.Start, slot.End, slot.Count, slot.Cap);
                        }
                    }
                }
            }
            catch (System.Text.Json.JsonException)
            {
                // JSONパースエラーは無視して続行
            }
        }

        return slotMap.Select(kvp => new TimeSlotStats
        {
            Time = kvp.Key,
            Count = kvp.Value.Count,
            Cap = kvp.Value.Cap,
            IsGrayedOut = false,
            FilteredCount = 0
        }).OrderBy(s => s.Time).ToList();
    }

    private class GraphDefinition
    {
        [System.Text.Json.Serialization.JsonPropertyName("slots")]
        public List<GraphSlotItem> Slots { get; set; } = new();
    }

    private class GraphSlotItem
    {
        [System.Text.Json.Serialization.JsonPropertyName("start")]
        public TimeOnly Start { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("end")]
        public TimeOnly End { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("count")]
        public int Count { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("cap")]
        public int Cap { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("available")]
        public int Available { get; set; }
    }

    private string GetBarColor(double vacancyRatio)
    {
        // 空き率に基づいて色を決定（空きが多い→目立つ色、空きが少ない→目立たない色）
        return vacancyRatio switch
        {
            >= 70 => "#10b981",  // 緑 (空きが多い - 目立つ)
            >= 30 => "#34d399",  // エメラルド (空きあり)
            > 0 => "#9ca3af",    // グレー (空き少ない - 目立たない)
            _ => "#6b7280"       // ダークグレー (満杯 - 表示されない想定)
        };
    }

    // GetCoarseSlotLabelメソッドは削除されました（Equipment関連）

    private async Task HandleClose()
    {
        await OnClose.InvokeAsync();
    }
}
