@* 日付詳細ポップアップ - 通常予約と設備別予約を2列表示 *@
@using Aloe.Apps.MedockLib.Services
@inject IEquipmentService EquipmentService

@if (IsOpen)
{
    <div class="modal modal-open">
        <!-- 背景ぼかし -->
        <div class="modal-backdrop backdrop-blur-sm bg-black/30" @onclick="HandleClose"></div>

        <div class="modal-box max-w-4xl h-[80vh] overflow-hidden flex flex-col">
            <!-- ヘッダー -->
            <div class="flex items-center justify-between mb-4">
                <h3 class="font-bold text-lg">
                    @if (SelectedDate.HasValue)
                    {
                        @SelectedDate.Value.ToString("yyyy年MM月dd日 (ddd)")
                    }
                </h3>
                <button class="btn btn-sm btn-circle btn-ghost" @onclick="HandleClose">✕</button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 flex-1 overflow-hidden">
                <!-- 左側: 通常予約の横棒グラフ -->
                <div class="flex flex-col overflow-hidden">
                    <h4 class="font-semibold mb-2">通常予約</h4>
                    <div class="overflow-y-auto space-y-3">
                        @if (DayStats?.Slots != null)
                        {
                            @foreach (var slot in DayStats.Slots)
                            {
                                // 空き率を計算（1 - 使用率）
                                var vacancyRatio = slot.Max > 0 ? (1 - slot.Count / (double)slot.Max) * 100 : 0;
                                // 空き率が0%より大きい場合のみ表示
                                if (vacancyRatio > 0)
                                {
                                    var color = GetBarColor(vacancyRatio);

                                    <div>
                                        <div class="flex justify-between text-sm mb-1">
                                            <span class="font-medium">@slot.Time</span>
                                            <span>@slot.Count/@slot.Max (空き:@Math.Round(vacancyRatio)%)</span>
                                        </div>
                                        <div class="bg-base-200 h-6 rounded overflow-hidden">
                                            <div class="h-full transition-all"
                                                 style="width: @(vacancyRatio)%; background-color: @color;"></div>
                                        </div>
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <div class="text-center text-base-content/60 py-8">
                                データがありません
                            </div>
                        }
                    </div>
                </div>

                <!-- 右側: 選択された設備の横棒グラフ -->
                <div class="flex flex-col overflow-hidden">
                    <h4 class="font-semibold mb-2">設備別予約</h4>
                    @if (IsLoadingEquipmentStats)
                    {
                        <div class="flex justify-center items-center h-32">
                            <span class="loading loading-spinner loading-lg"></span>
                        </div>
                    }
                    else if (EquipmentStats.Any())
                    {
                        <div class="overflow-y-auto space-y-4">
                            @foreach (var equipmentStat in EquipmentStats)
                            {
                                <div class="border-l-4 border-primary pl-3">
                                    <h5 class="font-medium mb-2">@GetEquipmentName(equipmentStat.EquipId)</h5>
                                    <div class="space-y-2">
                                        @foreach (var slot in equipmentStat.ApptGraph.Slots)
                                        {
                                            // 空き率を計算（1 - 使用率）
                                            var vacancyRatio = slot.Max > 0 ? (1 - slot.Count / (double)slot.Max) * 100 : 0;
                                            // 空き率が0%より大きい場合のみ表示
                                            if (vacancyRatio > 0)
                                            {
                                                var color = GetBarColor(vacancyRatio);
                                                var timeLabel = slot.IsCoarseSlot ? GetCoarseSlotLabel(slot.Time) : slot.Time;

                                                <div>
                                                    <div class="flex justify-between text-xs mb-1">
                                                        <span class="@(slot.IsCoarseSlot ? "font-bold" : "")">@timeLabel</span>
                                                        <span>@slot.Count/@slot.Max (空き:@Math.Round(vacancyRatio)%)</span>
                                                    </div>
                                                    <div class="bg-base-200 h-4 rounded overflow-hidden">
                                                        <div class="h-full transition-all"
                                                             style="width: @(vacancyRatio)%; background-color: @color;"></div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-base-content/60 py-8">
                            設備が選択されていません
                        </div>
                    }
                </div>
            </div>

            <!-- フッター -->
            <div class="modal-action">
                <button class="btn btn-ghost" @onclick="HandleClose">閉じる</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public DateOnly? SelectedDate { get; set; }
    [Parameter] public CalendarDayStats? DayStats { get; set; }
    [Parameter] public List<Guid> SelectedEquipmentIds { get; set; } = new();
    [Parameter] public List<SearchFilterPanel.FilterItem> AvailableEquipments { get; set; } = new();
    [Parameter] public EventCallback OnClose { get; set; }

    private List<EquipmentAppointmentStatsDto> EquipmentStats { get; set; } = new();
    private bool IsLoadingEquipmentStats { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && SelectedDate.HasValue && SelectedEquipmentIds.Any())
        {
            await LoadEquipmentStatsAsync();
        }
        else if (!SelectedEquipmentIds.Any())
        {
            EquipmentStats = new();
        }
    }

    private async Task LoadEquipmentStatsAsync()
    {
        IsLoadingEquipmentStats = true;
        StateHasChanged();

        try
        {
            EquipmentStats = await EquipmentService.GetEquipmentStatsAsync(SelectedEquipmentIds, SelectedDate!.Value);
        }
        catch
        {
            EquipmentStats = new();
        }
        finally
        {
            IsLoadingEquipmentStats = false;
            StateHasChanged();
        }
    }

    private string GetEquipmentName(Guid equipId)
    {
        return AvailableEquipments.FirstOrDefault(e => e.Id == equipId)?.Name ?? "不明";
    }

    private string GetBarColor(double vacancyRatio)
    {
        // 空き率に基づいて色を決定（空きが多い→目立つ色、空きが少ない→目立たない色）
        return vacancyRatio switch
        {
            >= 70 => "#10b981",  // 緑 (空きが多い - 目立つ)
            >= 30 => "#34d399",  // エメラルド (空きあり)
            > 0 => "#9ca3af",    // グレー (空き少ない - 目立たない)
            _ => "#6b7280"       // ダークグレー (満杯 - 表示されない想定)
        };
    }

    private string GetCoarseSlotLabel(string time)
    {
        return time switch
        {
            "AM" => "午前",
            "PM" => "午後",
            _ => time
        };
    }

    private async Task HandleClose()
    {
        await OnClose.InvokeAsync();
    }
}
