@* 日付詳細ポップアップ - Konva.jsグラフ表示版 *@
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

@if (IsOpen)
{
    <div class="modal modal-open">
        <!-- 背景ぼかし -->
        <div class="modal-backdrop backdrop-blur-sm bg-black/30" @onclick="HandleClose"></div>

        <div class="modal-box max-w-[90vw] max-h-[90vh] w-[90vw] h-[90vh] overflow-hidden flex flex-col bg-base-100/90 backdrop-blur-md">
            <!-- ヘッダー -->
            <div class="flex items-start justify-between mb-2 flex-shrink-0">
                @if (SelectedDate.HasValue)
                {
                    <div class="flex flex-col">
                        <!-- 年月日を大きめに表示 -->
                        <h3 class="font-bold text-2xl">
                            @SelectedDate.Value.ToString("yyyy年MM月dd日")
                        </h3>
                        <!-- 曜日 + 件数 + 割合 + 記号 -->
                        <div class="flex items-center gap-2 text-base mt-1">
                            <span>@GetDayOfWeekJapanese(SelectedDate.Value)</span>
                            <span>@GetTotalCount()件</span>
                            <span>空き@(Math.Round(GetOverallVacancyRatio() * 100))%</span>
                            <span class="font-bold text-lg @GetSymbolColorClass()">@GetSymbol()</span>
                        </div>
                    </div>
                }
                <button class="btn btn-sm btn-circle btn-ghost" @onclick="HandleClose">✕</button>
            </div>

            <!-- Konvaキャンバスコンテナ -->
            <div class="flex-1 overflow-hidden" style="min-height: 0;">
                <div id="@ChartContainerId" style="width: 100%; height: 100%;"></div>
            </div>

            <!-- フッター -->
            <div class="modal-action justify-between flex-shrink-0 mt-4">
                <div class="flex gap-2">
                    <button class="btn btn-outline btn-primary" disabled>仮予約（仮）</button>
                    <button class="btn btn-primary" disabled>予約（仮）</button>
                </div>
                <div class="flex gap-2">
                    <button class="btn btn-primary" @onclick="HandleGoToWeekView">週表示へ</button>
                    <button class="btn btn-ghost" @onclick="HandleClose">閉じる</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public DateOnly? SelectedDate { get; set; }
    [Parameter] public List<Aloe.Apps.MedockLib.Data.Entities.AppointmentStats>? MainStats { get; set; }
    [Parameter] public List<Aloe.Apps.MedockLib.Data.Entities.AppointmentStats>? EquipmentStats { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<DateOnly> OnGoToWeekView { get; set; }

    private string ChartContainerId { get; } = $"day-detail-chart-{Guid.CreateVersion7():N}";
    private bool _isChartRendered;
    private bool _wasOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // モーダルが開いた時にグラフを描画
        if (IsOpen && !_wasOpen && SelectedDate.HasValue)
        {
            _wasOpen = true;
            await RenderChartAsync();
        }
        else if (!IsOpen && _wasOpen)
        {
            _wasOpen = false;
            _isChartRendered = false;
            await DestroyChartAsync();
        }
    }

    private async Task RenderChartAsync()
    {
        if (!SelectedDate.HasValue || _isChartRendered)
            return;

        try
        {
            // MedockCalendarが読み込まれるまで待機
            var isReady = await JSRuntime.InvokeAsync<bool>("eval", "typeof window.MedockCalendar !== 'undefined' && typeof window.MedockCalendar.renderDayDetailPopup !== 'undefined'");
            if (!isReady)
            {
                // フォールバック: 少し待機して再試行
                await Task.Delay(100);
                isReady = await JSRuntime.InvokeAsync<bool>("eval", "typeof window.MedockCalendar !== 'undefined'");
            }

            if (isReady)
            {
                var dateStr = SelectedDate.Value.ToString("yyyy-MM-dd");
                await JSRuntime.InvokeVoidAsync("MedockCalendar.renderDayDetailPopup", ChartContainerId, dateStr);
                _isChartRendered = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"DayDetailPopup: Failed to render chart: {ex.Message}");
        }
    }

    private async Task DestroyChartAsync()
    {
        try
        {
            var isReady = await JSRuntime.InvokeAsync<bool>("eval", "typeof window.MedockCalendar !== 'undefined' && typeof window.MedockCalendar.destroyDayDetailPopup !== 'undefined'");
            if (isReady)
            {
                await JSRuntime.InvokeVoidAsync("MedockCalendar.destroyDayDetailPopup", ChartContainerId);
            }
        }
        catch
        {
            // 破棄時のエラーは無視
        }
    }

    private List<TimeSlotStats> GetSlotsFromStats()
    {
        if (MainStats == null || !MainStats.Any())
            return new List<TimeSlotStats>();

        var slotMap = new Dictionary<string, (TimeOnly Start, TimeOnly End, int Count, int Cap)>();

        foreach (var stat in MainStats)
        {
            if (stat.AppointmentStatSlots != null)
            {
                foreach (var statSlot in stat.AppointmentStatSlots.Where(s => !s.IsDeleted))
                {
                    var slotStartTime = TimeOnly.FromTimeSpan(TimeSpan.FromMinutes(statSlot.SlotStart));
                    var slotEndTime = TimeOnly.FromTimeSpan(TimeSpan.FromMinutes(statSlot.SlotEnd));
                    var timeRangeKey = $"{slotStartTime:HH:mm}-{slotEndTime:HH:mm}";
                    
                    if (slotMap.ContainsKey(timeRangeKey))
                    {
                        var existing = slotMap[timeRangeKey];
                        slotMap[timeRangeKey] = (existing.Start, existing.End, existing.Count + statSlot.SlotCount, existing.Cap + statSlot.SlotCap);
                    }
                    else
                    {
                        slotMap[timeRangeKey] = (slotStartTime, slotEndTime, statSlot.SlotCount, statSlot.SlotCap);
                    }
                }
            }
        }

        return slotMap.Select(kvp => new TimeSlotStats
        {
            Time = kvp.Key,
            Count = kvp.Value.Count,
            Cap = kvp.Value.Cap,
            IsGrayedOut = false,
            FilteredCount = 0
        }).OrderBy(s => s.Time).ToList();
    }

    private static readonly string[] DayOfWeekNames = ["日曜日", "月曜日", "火曜日", "水曜日", "木曜日", "金曜日", "土曜日"];

    private string GetDayOfWeekJapanese(DateOnly date)
    {
        return DayOfWeekNames[(int)date.DayOfWeek];
    }

    private int GetTotalCount()
    {
        var slots = GetSlotsFromStats();
        return slots.Sum(s => s.Count);
    }

    private double GetOverallVacancyRatio()
    {
        var slots = GetSlotsFromStats();
        var totalCount = slots.Sum(s => s.Count);
        var totalCap = slots.Sum(s => s.Cap);
        if (totalCap == 0) return 0;
        return (double)(totalCap - totalCount) / totalCap;
    }

    private string GetSymbol()
    {
        var vacancyRatio = GetOverallVacancyRatio();
        return vacancyRatio switch
        {
            <= 0 => "×",
            < 0.3 => "△",
            < 0.6 => "○",
            _ => "◎"
        };
    }

    private string GetSymbolColorClass()
    {
        var vacancyRatio = GetOverallVacancyRatio();
        return vacancyRatio switch
        {
            <= 0 => "text-red-500",
            < 0.3 => "text-yellow-500",
            _ => "text-emerald-500"
        };
    }

    private async Task HandleClose()
    {
        await OnClose.InvokeAsync();
    }

    private async Task HandleGoToWeekView()
    {
        if (SelectedDate.HasValue)
        {
            await OnGoToWeekView.InvokeAsync(SelectedDate.Value);
        }
        await HandleClose();
    }
}
