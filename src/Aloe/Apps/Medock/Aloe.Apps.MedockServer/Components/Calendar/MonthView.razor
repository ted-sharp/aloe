@* 
    MonthView - 月間カレンダー表示（Canvas版）
    各日をAM/PM円グラフで表示し、予約状況を視覚化
*@

<CalendarCanvas 
    ViewType="month"
    CurrentDate="@CurrentDate"
    DayStats="@DayStats"
    Holidays="@Holidays"
    Height="@Height"
    OnDateSelected="@HandleDateSelected" />

@code {
    /// <summary>
    /// 表示する月の基準日
    /// </summary>
    [Parameter]
    public DateOnly CurrentDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);

    /// <summary>
    /// 日別統計データ
    /// </summary>
    [Parameter]
    public Dictionary<string, CalendarCanvas.CalendarDayStats>? DayStats { get; set; }

    /// <summary>
    /// 祝日データ（日付文字列 -> 祝日名）
    /// </summary>
    [Parameter]
    public Dictionary<string, string>? Holidays { get; set; }

    /// <summary>
    /// カレンダーの高さ
    /// </summary>
    [Parameter]
    public string Height { get; set; } = "600px";

    /// <summary>
    /// 日付クリック時のコールバック
    /// </summary>
    [Parameter]
    public EventCallback<DateOnly> OnDateClick { get; set; }

    private async Task HandleDateSelected(DateOnly date)
    {
        await OnDateClick.InvokeAsync(date);
    }
}
