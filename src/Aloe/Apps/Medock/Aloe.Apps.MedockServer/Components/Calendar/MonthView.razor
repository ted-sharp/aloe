@* 
    MonthView - 月間カレンダー表示（Canvas版）
    各日をAM/PM円グラフで表示し、予約状況を視覚化
*@

<div class="month-view flex flex-col h-full">
    <!-- 月選択ボタンと設備表示スイッチ -->
    <div class="flex items-center gap-2 mb-4 flex-shrink-0">
        <span class="text-sm font-medium text-base-content/70">月:</span>
        <div class="btn-group">
            @{
                var today = DateOnly.FromDateTime(DateTime.Today);
                var currentMonth = new DateOnly(CurrentDate.Year, CurrentDate.Month, 1);
                for (int i = -1; i <= 6; i++)
                {
                    var monthDate = today.AddMonths(i);
                    var isCurrent = monthDate.Year == currentMonth.Year && monthDate.Month == currentMonth.Month;
                    <button class="btn btn-sm @(isCurrent ? "btn-active btn-primary" : "")"
                            @onclick="() => HandleMonthSelected(monthDate.Year, monthDate.Month)">
                        @(monthDate.Month)月
                    </button>
                }
            }
        </div>
        
        <div class="divider divider-horizontal mx-2"></div>
        
        <!-- 簡易|詳細切り替えボタン -->
        <div class="join">
            <button class="btn btn-xs join-item @(ShowSimpleView ? "btn-active btn-primary" : "")"
                    @onclick="() => HandleSimpleViewChanged(true)">
                簡易
            </button>
            <button class="btn btn-xs join-item @(!ShowSimpleView ? "btn-active btn-primary" : "")"
                    @onclick="() => HandleSimpleViewChanged(false)">
                詳細
            </button>
        </div>
        
        <div class="divider divider-horizontal mx-2"></div>
        
        <!-- 設備表示スイッチ -->
        <label class="label cursor-pointer">
            <span class="label-text text-sm mr-2">設備表示</span>
            <input type="checkbox" class="toggle toggle-primary toggle-sm" 
                   @bind="ShowEquipmentGraph" @bind:after="HandleEquipmentGraphChanged" />
        </label>
    </div>

    <!-- Canvas カレンダー -->
    <div class="flex-1 min-h-0">
        <CalendarCanvas 
            ViewType="month"
            CurrentDate="@CurrentDate"
            DayStats="@DayStats"
            Holidays="@Holidays"
            ShowSimpleView="@ShowSimpleView"
            ShowEquipmentGraph="@ShowEquipmentGraph"
            Height="100%"
            OnDateSelected="@HandleDateSelected"
            OnDateDoubleClicked="@HandleDateDoubleClicked" />
    </div>
</div>

@code {
    /// <summary>
    /// 表示する月の基準日
    /// </summary>
    [Parameter]
    public DateOnly CurrentDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);

    /// <summary>
    /// 日別統計データ
    /// </summary>
    [Parameter]
    public Dictionary<string, CalendarCanvas.CalendarDayStats>? DayStats { get; set; }

    /// <summary>
    /// 祝日データ（日付文字列 -> 祝日名）
    /// </summary>
    [Parameter]
    public Dictionary<string, string>? Holidays { get; set; }

    /// <summary>
    /// 簡易表示モード（記号表示）を表示するかどうか
    /// </summary>
    [Parameter]
    public bool ShowSimpleView { get; set; } = false;

    /// <summary>
    /// 設備折れ線グラフを表示するかどうか
    /// </summary>
    [Parameter]
    public bool ShowEquipmentGraph { get; set; } = false;

    /// <summary>
    /// カレンダーの高さ
    /// </summary>
    [Parameter]
    public string Height { get; set; } = "600px";

    /// <summary>
    /// 日付クリック時のコールバック
    /// </summary>
    [Parameter]
    public EventCallback<DateOnly> OnDateClick { get; set; }

    /// <summary>
    /// 日付ダブルクリック時のコールバック（その日のスケジュール表示）
    /// </summary>
    [Parameter]
    public EventCallback<DateOnly> OnDateDoubleClick { get; set; }

    /// <summary>
    /// 月選択時のコールバック
    /// </summary>
    [Parameter]
    public EventCallback<(int Year, int Month)> OnMonthSelected { get; set; }

    /// <summary>
    /// 簡易表示切り替え時のコールバック
    /// </summary>
    [Parameter]
    public EventCallback<bool> OnSimpleViewChanged { get; set; }

    /// <summary>
    /// 設備表示スイッチ変更時のコールバック
    /// </summary>
    [Parameter]
    public EventCallback<bool> OnEquipmentGraphChanged { get; set; }

    private async Task HandleDateSelected(DateOnly date)
    {
        await OnDateClick.InvokeAsync(date);
    }

    private async Task HandleDateDoubleClicked(DateOnly date)
    {
        await OnDateDoubleClick.InvokeAsync(date);
    }

    private async Task HandleMonthSelected(int year, int month)
    {
        await OnMonthSelected.InvokeAsync((year, month));
    }

    private async Task HandleSimpleViewChanged(bool showSimpleView)
    {
        ShowSimpleView = showSimpleView;
        await OnSimpleViewChanged.InvokeAsync(ShowSimpleView);
    }

    private async Task HandleEquipmentGraphChanged()
    {
        await OnEquipmentGraphChanged.InvokeAsync(ShowEquipmentGraph);
    }
}
