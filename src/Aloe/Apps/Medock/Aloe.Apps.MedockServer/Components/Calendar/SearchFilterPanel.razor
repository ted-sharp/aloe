@*
    SearchFilterPanel - カレンダー用の検索フィルターパネル
    条件に当てはまらない日/時間帯をグレーアウト表示するためのフィルター
*@

<div class="card bg-base-100 shadow-sm mb-4">
    <div class="card-body p-4">
        <!-- ヘッダー: タイトルと閉じるボタン -->
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                </svg>
                <h3 class="font-bold text-base-content">空き検索フィルター</h3>
                @if (ActiveFilterCount > 0)
                {
                    <span class="badge badge-primary badge-sm">@ActiveFilterCount</span>
                }
            </div>
            <button class="btn btn-sm btn-ghost btn-square" @onclick="HandleClose" title="閉じる">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <div class="divider my-2"></div>

        <!-- フィルター詳細パネル -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- 曜日 -->
            <div class="form-control">
                <label class="label">
                    <span class="label-text font-semibold">曜日</span>
                    <div class="flex gap-1">
                        <button type="button" class="btn btn-xs btn-ghost" @onclick="SelectAllDays">全選択</button>
                        <button type="button" class="btn btn-xs btn-ghost" @onclick="ClearAllDays">全解除</button>
                    </div>
                </label>
                <div class="flex flex-wrap gap-1">
                    @foreach (var (day, index) in DayNames.Select((d, i) => (d, i)))
                    {
                        var dayIndex = index;
                        <label class="cursor-pointer">
                            <input type="checkbox"
                                   class="checkbox checkbox-xs checkbox-primary hidden peer"
                                   checked="@SelectedDays.Contains(dayIndex)"
                                   @onchange="() => ToggleDay(dayIndex)" />
                            <span class="badge @(SelectedDays.Contains(dayIndex) ? "badge-primary" : "badge-outline")
                                         @(dayIndex == 0 ? "text-error" : dayIndex == 6 ? "text-info" : "")">
                                @day
                            </span>
                        </label>
                    }
                </div>
            </div>

            <!-- 時間帯 -->
            <div class="form-control">
                <label class="label">
                    <span class="label-text font-semibold">時間帯</span>
                    <div class="flex gap-1">
                        <button type="button" class="btn btn-xs btn-ghost" @onclick="SelectAllTimeSlots">全選択</button>
                        <button type="button" class="btn btn-xs btn-ghost" @onclick="ClearAllTimeSlots">全解除</button>
                    </div>
                </label>
                <div class="flex flex-wrap gap-1">
                    @foreach (var slot in TimeSlots)
                    {
                        <label class="cursor-pointer">
                            <input type="checkbox"
                                   class="checkbox checkbox-xs checkbox-primary hidden peer"
                                   checked="@SelectedTimeSlots.Contains(slot)"
                                   @onchange="() => ToggleTimeSlot(slot)" />
                            <span class="badge @(SelectedTimeSlots.Contains(slot) ? "badge-primary" : "badge-outline")">
                                @slot
                            </span>
                        </label>
                    }
                </div>
            </div>

            <!-- 必要人数 -->
            <div class="form-control">
                <label class="label">
                    <span class="label-text font-semibold">空き枠数</span>
                </label>
                <div class="flex items-center gap-2">
                    <input type="number" class="input input-bordered input-sm w-20"
                           min="1" max="10"
                           @bind="RequiredCapacity" @bind:event="oninput" @bind:after="OnFilterChanged" />
                    <span class="text-sm text-base-content/60">名以上</span>
                </div>
            </div>

            <!-- 設備 -->
            <div class="form-control">
                <label class="label">
                    <span class="label-text font-semibold">設備</span>
                    <div class="flex gap-1">
                        <button type="button" class="btn btn-xs btn-ghost" @onclick="SelectAllEquipments">全選択</button>
                        <button type="button" class="btn btn-xs btn-ghost" @onclick="ClearAllEquipments">全解除</button>
                    </div>
                </label>
                <div class="flex flex-wrap gap-1 max-h-40 overflow-y-auto border border-base-300 rounded-lg p-2">
                    @foreach (var equipment in AvailableEquipments)
                    {
                        <label class="cursor-pointer">
                            <input type="checkbox"
                                   class="checkbox checkbox-xs checkbox-primary hidden peer"
                                   checked="@SelectedEquipments.Contains(equipment.Id)"
                                   @onchange="() => ToggleEquipment(equipment.Id)" />
                            <span class="badge @(SelectedEquipments.Contains(equipment.Id) ? "badge-primary" : "badge-outline")">
                                @equipment.Name
                            </span>
                        </label>
                    }
                </div>
            </div>
        </div>

        <!-- クリアボタン -->
        <div class="flex justify-end mt-4">
            <button class="btn btn-ghost btn-sm" @onclick="ClearFilters">
                クリア
            </button>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// 利用可能な設備のリスト
    /// </summary>
    [Parameter]
    public List<FilterItem> AvailableEquipments { get; set; } = new();

    /// <summary>
    /// フィルター変更時のコールバック
    /// </summary>
    [Parameter]
    public EventCallback<SearchFilter> OnFilterApplied { get; set; }

    /// <summary>
    /// リアルタイム検索用のコールバック
    /// </summary>
    [Parameter]
    public EventCallback<SearchFilter> OnFilterChangedRealtime { get; set; }

    /// <summary>
    /// パネルを閉じる時のコールバック
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    // フィルター値
    private HashSet<int> SelectedDays { get; set; } = new(); // デフォルト全オフ
    private HashSet<string> SelectedTimeSlots { get; set; } = new(); // 時間帯複数選択
    private int RequiredCapacity { get; set; } = 1;
    private HashSet<Guid> SelectedEquipments { get; set; } = new();

    // 定数
    private readonly string[] DayNames = { "日", "月", "火", "水", "木", "金", "土" };
    private readonly string[] TimeSlots = { "08:00", "09:00", "10:00", "11:00", "13:00", "14:00", "15:00", "16:00" };

    private int ActiveFilterCount =>
        (SelectedDays.Any() ? 1 : 0) +
        (SelectedTimeSlots.Any() ? 1 : 0) +
        (RequiredCapacity > 1 ? 1 : 0) +
        (SelectedEquipments.Any() ? 1 : 0);

    private async Task HandleClose()
    {
        await OnClose.InvokeAsync();
    }

    private void ToggleDay(int dayIndex)
    {
        if (SelectedDays.Contains(dayIndex))
        {
            SelectedDays.Remove(dayIndex);
        }
        else
        {
            SelectedDays.Add(dayIndex);
        }
        OnFilterChanged();
    }

    private void ToggleEquipment(Guid equipId)
    {
        if (SelectedEquipments.Contains(equipId))
        {
            SelectedEquipments.Remove(equipId);
        }
        else
        {
            SelectedEquipments.Add(equipId);
        }
        OnFilterChanged();
    }

    private void ToggleTimeSlot(string timeSlot)
    {
        if (SelectedTimeSlots.Contains(timeSlot))
        {
            SelectedTimeSlots.Remove(timeSlot);
        }
        else
        {
            SelectedTimeSlots.Add(timeSlot);
        }
        OnFilterChanged();
    }

    private void ClearFilters()
    {
        SelectedDays = new();
        SelectedTimeSlots.Clear();
        RequiredCapacity = 1;
        SelectedEquipments.Clear();
        OnFilterChanged();
    }

    private async void OnFilterChanged()
    {
        // リアルタイム検索
        var filter = BuildFilter();
        await OnFilterChangedRealtime.InvokeAsync(filter);
    }

    private SearchFilter BuildFilter()
    {
        return new SearchFilter
        {
            SelectedDays = SelectedDays.ToList(),
            TimeSlots = SelectedTimeSlots.ToList(),
            RequiredCapacity = RequiredCapacity,
            EquipIds = SelectedEquipments.ToList()
        };
    }

    /// <summary>
    /// フィルター選択肢の項目
    /// </summary>
    public class FilterItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    private void SelectAllDays()
    {
        SelectedDays = Enumerable.Range(0, 7).ToHashSet();
        OnFilterChanged();
    }

    private void ClearAllDays()
    {
        SelectedDays.Clear();
        OnFilterChanged();
    }

    private void SelectAllTimeSlots()
    {
        SelectedTimeSlots = TimeSlots.ToHashSet();
        OnFilterChanged();
    }

    private void ClearAllTimeSlots()
    {
        SelectedTimeSlots.Clear();
        OnFilterChanged();
    }

    private void SelectAllEquipments()
    {
        SelectedEquipments = AvailableEquipments.Select(e => e.Id).ToHashSet();
        OnFilterChanged();
    }

    private void ClearAllEquipments()
    {
        SelectedEquipments.Clear();
        OnFilterChanged();
    }

    /// <summary>
    /// 検索フィルターのデータ
    /// </summary>
    public class SearchFilter
    {
        public List<int> SelectedDays { get; set; } = new();
        public List<string> TimeSlots { get; set; } = new();
        public int RequiredCapacity { get; set; } = 1;
        public List<Guid> EquipIds { get; set; } = new();

        /// <summary>
        /// フィルターが有効かどうか
        /// </summary>
        public bool IsActive =>
            SelectedDays.Any() ||
            TimeSlots.Any() ||
            RequiredCapacity > 1 ||
            EquipIds.Any();
    }
}
