@page "/calendar"
@using Aloe.Apps.MedockLib.Services
@inject IAppointmentService AppointmentService

<PageTitle>カレンダー - Aloe Medock</PageTitle>

<div class="space-y-4">
    <!-- ヘッダー -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold text-base-content">予約カレンダー</h1>
            <p class="text-base-content/60 mt-1">予約状況を確認・管理できます</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <!-- ビュー切り替え -->
            <div class="btn-group">
                <button class="btn @(CurrentView == CalendarViewType.Year ? "btn-active btn-primary" : "")" 
                        @onclick="() => SetView(CalendarViewType.Year)">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    年
                </button>
                <button class="btn @(CurrentView == CalendarViewType.Month ? "btn-active btn-primary" : "")" 
                        @onclick="() => SetView(CalendarViewType.Month)">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    月
                </button>
                <button class="btn @(CurrentView == CalendarViewType.Week ? "btn-active btn-primary" : "")" 
                        @onclick="() => SetView(CalendarViewType.Week)">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                    </svg>
                    週
                </button>
            </div>
            <button class="btn btn-primary" @onclick="OpenNewAppointmentModal">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                新規予約
            </button>
        </div>
    </div>

    <!-- カレンダーナビゲーション -->
    <div class="card bg-base-100 shadow">
        <div class="card-body p-4">
            <div class="flex items-center justify-between">
                <button class="btn btn-ghost btn-circle" @onclick="PreviousPeriod">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>
                <div class="text-center">
                    <h2 class="text-xl font-bold">@GetCurrentPeriodTitle()</h2>
                    <button class="btn btn-ghost btn-sm" @onclick="GoToToday">今日</button>
                </div>
                <button class="btn btn-ghost btn-circle" @onclick="NextPeriod">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- 検索フィルター（年間表示の場合のみ表示） -->
    @if (CurrentView == CalendarViewType.Year)
    {
        <SearchFilterPanel @ref="filterPanelRef"
            AvailableRooms="@AvailableRooms"
            OnFilterApplied="@HandleFilterApplied"
            OnFilterChangedRealtime="@HandleFilterChangedRealtime" />
    }

    <!-- カレンダー本体 -->
    <div class="card bg-base-100 shadow overflow-hidden">
        <div class="card-body p-2 sm:p-4">
            @if (CurrentView == CalendarViewType.Year)
            {
                <YearView 
                    CurrentDate="@CurrentDate" 
                    DayStats="@SampleDayStats"
                    Holidays="@Holidays"
                    Height="700px"
                    OnDateClick="@HandleDateClick"
                    OnMonthClick="@HandleMonthClick"
                    OnDateSelect="@HandleDateSelect"
                    OnDateDoubleClick="@HandleDateDoubleClick"
                    OnDateRangeSelect="@HandleDateRangeSelect" />
            }
            else if (CurrentView == CalendarViewType.Month)
            {
                <MonthView 
                    CurrentDate="@CurrentDate" 
                    DayStats="@SampleDayStats"
                    Holidays="@Holidays"
                    Height="600px"
                    OnDateClick="@HandleDateClick" />
            }
            else
            {
                <WeekScheduler 
                    CurrentDate="@CurrentDate"
                    WeekDays="@WeekDays"
                    ShowSlots="@ShowSlots"
                    Appointments="@SampleAppointments"
                    DayStats="@SampleDayStats"
                    Holidays="@Holidays"
                    Height="600px"
                    OnDateSelected="@HandleDateClick"
                    OnAppointmentClicked="@HandleAppointmentClick"
                    OnCreateRequested="@HandleCreateRequest"
                    OnWeekDaysChanged="@HandleWeekDaysChanged"
                    OnShowSlotsChanged="@HandleShowSlotsChanged"
                    OnAppointmentMoved="@HandleAppointmentMoved" />
            }
        </div>
    </div>

    <!-- 凡例 -->
    @if (CurrentView == CalendarViewType.Year || CurrentView == CalendarViewType.Month)
    {
        <!-- 年間・月間カレンダー用の凡例 -->
        <CalendarLegend />
    }
    else
    {
        <!-- 週間スケジューラー用の凡例 -->
        <div class="card bg-base-100 shadow">
            <div class="card-body p-4">
                <h3 class="font-bold mb-2">ステータス凡例</h3>
                <div class="flex flex-wrap gap-4">
                    <div class="flex items-center gap-2">
                        <span class="w-4 h-4 rounded bg-warning"></span>
                        <span class="text-sm">予約</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-4 h-4 rounded bg-info"></span>
                        <span class="text-sm">待機中</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-4 h-4 rounded bg-success"></span>
                        <span class="text-sm">来院済み</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-4 h-4 rounded bg-error"></span>
                        <span class="text-sm">キャンセル</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- 予約モーダル（後で実装） -->
@if (IsModalOpen)
{
    <AppointmentModal 
        IsOpen="@IsModalOpen"
        SelectedDate="@ModalDate"
        SelectedTime="@ModalTime"
        AppointmentId="@SelectedAppointmentId"
        OnClose="@CloseModal"
        OnSave="@HandleSaveAppointment" />
}

@code {
    private DateOnly CurrentDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    private CalendarViewType CurrentView { get; set; } = CalendarViewType.Month;
    private int WeekDays { get; set; } = 7;
    private bool ShowSlots { get; set; } = true;

    // Modal state
    private bool IsModalOpen { get; set; } = false;
    private DateOnly? ModalDate { get; set; }
    private TimeOnly? ModalTime { get; set; }
    private Guid? SelectedAppointmentId { get; set; }

    // 選択状態
    private DateOnly? SelectedDate { get; set; }
    private (DateOnly Start, DateOnly End)? SelectedDateRange { get; set; }

    // サンプルデータ（後で実データに置き換え）
    private Dictionary<string, CalendarCanvas.CalendarDayStats> SampleDayStats { get; set; } = new();
    private Dictionary<string, CalendarCanvas.CalendarDayStats> OriginalDayStats { get; set; } = new();
    private List<CalendarCanvas.CalendarAppointment> SampleAppointments { get; set; } = new();
    private Dictionary<string, string> Holidays { get; set; } = new();

    // フィルター用データ
    private List<SearchFilterPanel.FilterItem> AvailableRooms { get; set; } = new();
    private SearchFilterPanel.SearchFilter? CurrentFilter { get; set; }
    private SearchFilterPanel? filterPanelRef;

    private enum CalendarViewType
    {
        Year,
        Month,
        Week
    }

    protected override async Task OnInitializedAsync()
    {
        // サンプルデータを生成
        GenerateSampleData();
        
        // 部屋と設備のサンプルデータを生成
        GenerateFilterOptions();
        
        // 祝日データを取得
        await LoadHolidaysAsync();
    }

    private void GenerateFilterOptions()
    {
        // 部屋のサンプルデータ
        AvailableRooms = new List<SearchFilterPanel.FilterItem>
        {
            new() { Id = Guid.NewGuid(), Name = "問診室1" },
            new() { Id = Guid.NewGuid(), Name = "問診室2" },
            new() { Id = Guid.NewGuid(), Name = "問診室3" },
            new() { Id = Guid.NewGuid(), Name = "検査室1" },
            new() { Id = Guid.NewGuid(), Name = "検査室2" },
            new() { Id = Guid.NewGuid(), Name = "検査室3" },
            new() { Id = Guid.NewGuid(), Name = "X線室" },
            new() { Id = Guid.NewGuid(), Name = "CT室" },
            new() { Id = Guid.NewGuid(), Name = "MRI室" },
            new() { Id = Guid.NewGuid(), Name = "内視鏡室" },
        };
    }
    
    private async Task LoadHolidaysAsync()
    {
        try
        {
            var startDate = new DateOnly(CurrentDate.Year, 1, 1);
            var endDate = new DateOnly(CurrentDate.Year, 12, 31);
            var holidays = await AppointmentService.GetHolidaysAsync(startDate, endDate);
            
            Holidays = holidays.ToDictionary(
                h => h.Date.ToString("yyyy-MM-dd"),
                h => h.Name
            );
        }
        catch (Exception)
        {
            // 祝日取得に失敗しても動作を続行
            Holidays = new Dictionary<string, string>();
        }
    }

    private void GenerateSampleData()
    {
        var random = new Random(42); // 固定シードで再現性のあるデータ
        var today = DateTime.Today;
        var startDate = new DateTime(today.Year, 1, 1);
        var endDate = new DateTime(today.Year, 12, 31);

        // 時間帯枠の定義
        var slotTimes = new[] { "08:00", "09:00", "10:00", "11:00", "13:00", "14:00", "15:00", "16:00" };
        var slotMaxes = new[] { 5, 8, 8, 8, 8, 8, 8, 5 };

        // 日別統計を生成
        for (var date = startDate; date <= endDate; date = date.AddDays(1))
        {
            var dateStr = date.ToString("yyyy-MM-dd");
            var dayOfWeek = date.DayOfWeek;
            var isWeekend = dayOfWeek == DayOfWeek.Saturday || dayOfWeek == DayOfWeek.Sunday;
            
            // 時間帯枠ごとのデータを生成
            var slots = new List<CalendarCanvas.TimeSlotStats>();
            var amCount = 0;
            var pmCount = 0;
            var amMax = 0;
            var pmMax = 0;
            
            for (var i = 0; i < slotTimes.Length; i++)
            {
                var max = isWeekend ? Math.Max(1, slotMaxes[i] / 2) : slotMaxes[i];
                var count = random.Next(0, max + 1);
                
                slots.Add(new CalendarCanvas.TimeSlotStats
                {
                    Time = slotTimes[i],
                    Count = count,
                    Max = max,
                    IsGrayedOut = false
                });
                
                // AM/PM集計（フォールバック用）
                var hour = int.Parse(slotTimes[i].Split(':')[0]);
                if (hour < 12)
                {
                    amCount += count;
                    amMax += max;
                }
                else
                {
                    pmCount += count;
                    pmMax += max;
                }
            }
            
            var dayStats = new CalendarCanvas.CalendarDayStats
            {
                AmCount = amCount,
                PmCount = pmCount,
                AmMax = amMax,
                PmMax = pmMax,
                Slots = slots,
                IsGrayedOut = false
            };
            SampleDayStats[dateStr] = dayStats;
            
            // オリジナルデータを保存（フィルター解除用）
            OriginalDayStats[dateStr] = new CalendarCanvas.CalendarDayStats
            {
                AmCount = amCount,
                PmCount = pmCount,
                AmMax = amMax,
                PmMax = pmMax,
                Slots = slots.Select(s => new CalendarCanvas.TimeSlotStats
                {
                    Time = s.Time,
                    Count = s.Count,
                    Max = s.Max,
                    IsGrayedOut = false
                }).ToList(),
                IsGrayedOut = false
            };
        }

        // 今週の予約を生成
        var weekStart = today.AddDays(-(int)today.DayOfWeek);
        var names = new[] { "山田 太郎", "佐藤 花子", "鈴木 一郎", "田中 美咲", "高橋 健二" };
        var orgs = new[] { "株式会社ABC", "XYZ商事", "個人", "医療法人DEF", "○○健保組合" };

        for (var day = 0; day < 7; day++)
        {
            var date = weekStart.AddDays(day);
            var count = random.Next(3, 8);

            for (var i = 0; i < count; i++)
            {
                var startHour = random.Next(8, 16);
                var duration = random.Next(1, 3);
                
                SampleAppointments.Add(new CalendarCanvas.CalendarAppointment
                {
                    Id = Guid.NewGuid(),
                    Date = DateOnly.FromDateTime(date),
                    StartTime = new TimeOnly(startHour, 0),
                    EndTime = new TimeOnly(Math.Min(startHour + duration, 18), 0),
                    PatientName = names[random.Next(names.Length)],
                    OrganizationName = orgs[random.Next(orgs.Length)],
                    Status = random.Next(0, 4)
                });
            }
        }
    }

    private void SetView(CalendarViewType view)
    {
        CurrentView = view;
    }

    private string GetCurrentPeriodTitle()
    {
        return CurrentView switch
        {
            CalendarViewType.Year => $"{CurrentDate.Year}年",
            CalendarViewType.Month => $"{CurrentDate.Year}年{CurrentDate.Month}月",
            CalendarViewType.Week => WeekDays == 1 
                ? $"{CurrentDate.Year}年{CurrentDate.Month}月{CurrentDate.Day}日"
                : $"{CurrentDate.Year}年{CurrentDate.Month}月{CurrentDate.Day}日の週",
            _ => ""
        };
    }

    private void PreviousPeriod()
    {
        CurrentDate = CurrentView switch
        {
            CalendarViewType.Year => CurrentDate.AddYears(-1),
            CalendarViewType.Month => CurrentDate.AddMonths(-1),
            CalendarViewType.Week => CurrentDate.AddDays(-WeekDays),
            _ => CurrentDate
        };
    }

    private void NextPeriod()
    {
        CurrentDate = CurrentView switch
        {
            CalendarViewType.Year => CurrentDate.AddYears(1),
            CalendarViewType.Month => CurrentDate.AddMonths(1),
            CalendarViewType.Week => CurrentDate.AddDays(WeekDays),
            _ => CurrentDate
        };
    }

    private void GoToToday()
    {
        CurrentDate = DateOnly.FromDateTime(DateTime.Today);
    }

    private void HandleDateClick(DateOnly date)
    {
        CurrentDate = date;
        // 年→月、月→週へ遷移（旧動作、月間表示では日クリックで週間に遷移）
        if (CurrentView == CalendarViewType.Month)
        {
            CurrentView = CalendarViewType.Week;
            WeekDays = 7;
        }
    }

    /// <summary>
    /// 月ヘッダークリック時のハンドラ - 月間表示に切り替え
    /// </summary>
    private void HandleMonthClick((int Year, int Month) yearMonth)
    {
        CurrentDate = new DateOnly(yearMonth.Year, yearMonth.Month, 1);
        CurrentView = CalendarViewType.Month;
    }

    /// <summary>
    /// 日付シングルクリック時のハンドラ - 選択状態にする
    /// </summary>
    private void HandleDateSelect(DateOnly date)
    {
        SelectedDate = date;
        SelectedDateRange = null;
        // 年間表示ではビュー切り替えなし、選択のみ
    }

    /// <summary>
    /// 日付ダブルクリック時のハンドラ - その日のスケジュール表示
    /// </summary>
    private void HandleDateDoubleClick(DateOnly date)
    {
        CurrentDate = date;
        CurrentView = CalendarViewType.Week;
        WeekDays = 1; // 1日表示
    }

    /// <summary>
    /// 範囲選択時のハンドラ
    /// </summary>
    private void HandleDateRangeSelect((DateOnly Start, DateOnly End) range)
    {
        SelectedDate = null;
        SelectedDateRange = range;
    }

    /// <summary>
    /// フィルター適用時のハンドラ
    /// </summary>
    private void HandleFilterApplied(SearchFilterPanel.SearchFilter filter)
    {
        CurrentFilter = filter;
        ApplyFilterToStats(filter);
        StateHasChanged();
    }

    /// <summary>
    /// リアルタイムフィルター変更時のハンドラ
    /// </summary>
    private void HandleFilterChangedRealtime(SearchFilterPanel.SearchFilter filter)
    {
        CurrentFilter = filter;
        ApplyFilterToStats(filter);
        StateHasChanged();
    }

    /// <summary>
    /// フィルターをカレンダーデータに適用
    /// </summary>
    private void ApplyFilterToStats(SearchFilterPanel.SearchFilter filter)
    {
        // フィルターが無効な場合はオリジナルに戻す
        if (!filter.IsActive)
        {
            foreach (var kvp in OriginalDayStats)
            {
                if (SampleDayStats.TryGetValue(kvp.Key, out var stats))
                {
                    stats.IsGrayedOut = false;
                    if (stats.Slots != null)
                    {
                        foreach (var slot in stats.Slots)
                        {
                            slot.IsGrayedOut = false;
                            slot.FilteredCount = 0;
                        }
                    }
                }
            }
            return;
        }

        foreach (var kvp in SampleDayStats)
        {
            var dateStr = kvp.Key;
            var stats = kvp.Value;
            var date = DateOnly.Parse(dateStr);
            
            // 日付レベルのグレーアウト判定
            var isDateGrayed = false;

            // 曜日フィルター
            var dayOfWeek = (int)date.DayOfWeek;
            if (filter.SelectedDays.Any() && !filter.SelectedDays.Contains(dayOfWeek))
                isDateGrayed = true;

            // 時間帯枠レベルのグレーアウト判定
            var hasAvailableSlot = false;
            if (stats.Slots != null)
            {
                foreach (var slot in stats.Slots)
                {
                    var isSlotGrayed = false;

                    // 特定の時間帯フィルター
                    if (filter.TimeSlots.Any() && !filter.TimeSlots.Contains(slot.Time))
                    {
                        isSlotGrayed = true;
                    }

                    // 空き枠数フィルター
                    var availableCapacity = slot.Max - slot.Count;
                    if (filter.RequiredCapacity > 1 && availableCapacity < filter.RequiredCapacity)
                    {
                        isSlotGrayed = true;
                    }

                    // 部屋フィルター適用
                    if (filter.RoomIds.Any())
                    {
                        var roomFilteredCount = CalculateRoomFilteredCount(date, slot.Time, filter.RoomIds);
                        slot.FilteredCount = roomFilteredCount;
                    }
                    else
                    {
                        slot.FilteredCount = 0;
                    }

                    slot.IsGrayedOut = isSlotGrayed || isDateGrayed;

                    if (!slot.IsGrayedOut)
                        hasAvailableSlot = true;
                }
            }
            else
            {
                // スロットがない場合はAM/PMで判定
                var amAvailable = stats.AmMax - stats.AmCount;
                var pmAvailable = stats.PmMax - stats.PmCount;
                hasAvailableSlot = amAvailable >= filter.RequiredCapacity || pmAvailable >= filter.RequiredCapacity;
            }

            // 日付全体のグレーアウト（条件に合う枠が1つもない場合）
            stats.IsGrayedOut = isDateGrayed || !hasAvailableSlot;
        }
    }

    private void HandleAppointmentClick(Guid apptId)
    {
        SelectedAppointmentId = apptId;
        ModalDate = null;
        ModalTime = null;
        IsModalOpen = true;
    }

    private void HandleCreateRequest((DateOnly Date, TimeOnly Time) request)
    {
        SelectedAppointmentId = null;
        ModalDate = request.Date;
        ModalTime = request.Time;
        IsModalOpen = true;
    }

    private void HandleWeekDaysChanged(int days)
    {
        WeekDays = days;
    }

    private void HandleShowSlotsChanged(bool showSlots)
    {
        ShowSlots = showSlots;
    }

    private void OpenNewAppointmentModal()
    {
        SelectedAppointmentId = null;
        ModalDate = CurrentDate;
        ModalTime = new TimeOnly(9, 0);
        IsModalOpen = true;
    }

    private void CloseModal()
    {
        IsModalOpen = false;
        SelectedAppointmentId = null;
        ModalDate = null;
        ModalTime = null;
    }

    private void HandleSaveAppointment()
    {
        // TODO: 保存処理
        CloseModal();
    }

    private async Task HandleAppointmentMoved((Guid ApptId, DateOnly NewDate, TimeOnly NewTime) moveInfo)
    {
        try
        {
            // サンプルデータから既存の予約を取得して時間を計算
            var appt = SampleAppointments.FirstOrDefault(a => a.Id == moveInfo.ApptId);
            if (appt != null)
            {
                var duration = appt.EndTime.HasValue && appt.StartTime.HasValue 
                    ? appt.EndTime.Value - appt.StartTime.Value 
                    : TimeSpan.FromHours(1);
                var newEndTime = moveInfo.NewTime.Add(duration);
                
                // 予約時間を更新
                await AppointmentService.UpdateAppointmentAsync(
                    moveInfo.ApptId, 
                    new UpdateAppointmentDto
                    {
                        Date = moveInfo.NewDate,
                        StartTime = moveInfo.NewTime,
                        EndTime = newEndTime
                    });
                
                // サンプルデータも更新（後で実データに置き換え）
                appt.Date = moveInfo.NewDate;
                appt.StartTime = moveInfo.NewTime;
                appt.EndTime = newEndTime;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            // TODO: エラーハンドリング（トースト通知など）
            Console.WriteLine($"予約移動エラー: {ex.Message}");
        }
    }

    /// <summary>
    /// 部屋フィルター適用時の予約数を計算
    /// TODO: 実際のroom_appointment_statsテーブルから取得する実装に置き換え
    /// </summary>
    private int CalculateRoomFilteredCount(DateOnly date, string timeSlot, List<Guid> roomIds)
    {
        // Mock implementation: Return random count for demonstration
        // XORを使ってオーバーフローを回避
        var roomHash = 0;
        foreach (var roomId in roomIds)
        {
            roomHash ^= roomId.GetHashCode();
        }
        var seed = date.DayNumber ^ timeSlot.GetHashCode() ^ roomHash;
        var random = new Random(seed);
        return random.Next(0, 3);  // 0-2件のランダム
    }
}
