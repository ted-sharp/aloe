@page "/tenant-select"
@layout LoginLayout

<PageTitle>テナント選択 - Aloe Medock</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-aloe-50 via-white to-aloe-100 p-4">
    <div class="w-full max-w-md">
        <!-- ロゴとタイトル -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-aloe-500 mb-4 shadow-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
            </div>
            <h1 class="text-3xl font-bold text-gray-800">テナント選択</h1>
            <p class="text-gray-600 mt-2">ログインするテナントを選択してください</p>
        </div>

        <!-- ユーザー情報 -->
        <div class="mb-6">
            <div class="alert bg-base-200">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <span class="text-sm">@CurrentUserName さんとしてログイン中</span>
            </div>
        </div>

        <!-- テナント一覧 -->
        <div class="card bg-base-100 shadow-xl">
            <div class="card-body">
                <h2 class="card-title text-lg mb-4">利用可能なテナント</h2>

                @if (IsLoading)
                {
                    <div class="flex justify-center py-8">
                        <span class="loading loading-spinner loading-lg text-primary"></span>
                    </div>
                }
                else if (Tenants.Count == 0)
                {
                    <div class="alert alert-warning">
                        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                        <span>利用可能なテナントがありません。</span>
                    </div>
                }
                else
                {
                    <div class="space-y-3">
                        @foreach (var tenant in Tenants)
                        {
                            <button 
                                class="btn btn-outline btn-block justify-start gap-3 h-auto py-4 @(SelectedTenantId == tenant.TenantId ? "btn-primary" : "")"
                                @onclick="() => SelectTenant(tenant.TenantId)">
                                <div class="avatar placeholder">
                                    <div class="bg-primary text-primary-content rounded-full w-10">
                                        <span class="text-lg">@tenant.TenantName[0]</span>
                                    </div>
                                </div>
                                <div class="text-left">
                                    <div class="font-medium">@tenant.TenantName</div>
                                    <div class="text-xs opacity-60">@tenant.Description</div>
                                </div>
                            </button>
                        }
                    </div>

                    <div class="card-actions mt-6">
                        <button 
                            class="btn btn-primary w-full"
                            disabled="@(SelectedTenantId == Guid.Empty)"
                            @onclick="ConfirmSelection">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                            選択して続行
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- ログアウトリンク -->
        <div class="text-center mt-6">
            <a href="/login" class="link link-primary text-sm">
                別のユーザーでログイン
            </a>
        </div>

        <!-- フッター -->
        <div class="text-center mt-6 text-sm text-gray-500">
            <p>© 2025 Aloe Medock. All rights reserved.</p>
        </div>
    </div>
</div>

@code {
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private string CurrentUserName { get; set; } = "システム管理者";
    private bool IsLoading { get; set; } = true;
    private Guid SelectedTenantId { get; set; } = Guid.Empty;
    private List<TenantInfo> Tenants { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadTenants();
    }

    private async Task LoadTenants()
    {
        IsLoading = true;
        StateHasChanged();

        // TODO: 実際のテナント取得処理
        await Task.Delay(500);

        // デモ用データ
        Tenants = new List<TenantInfo>
        {
            new TenantInfo 
            { 
                TenantId = Guid.NewGuid(), 
                TenantName = "○○病院", 
                Description = "医療施設 - 予約管理" 
            },
            new TenantInfo 
            { 
                TenantId = Guid.NewGuid(), 
                TenantName = "△△クリニック", 
                Description = "診療所 - 予約管理" 
            },
            new TenantInfo 
            { 
                TenantId = Guid.NewGuid(), 
                TenantName = "□□健診センター", 
                Description = "健診施設 - 予約管理" 
            }
        };

        IsLoading = false;
        StateHasChanged();
    }

    private void SelectTenant(Guid tenantId)
    {
        SelectedTenantId = tenantId;
    }

    private void ConfirmSelection()
    {
        if (SelectedTenantId != Guid.Empty)
        {
            // TODO: テナント選択をセッションに保存
            NavigationManager.NavigateTo("/calendar");
        }
    }

    private class TenantInfo
    {
        public Guid TenantId { get; set; }
        public string TenantName { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
}

