@* 右下アクションFAB（daisyUI v5 fab-flower） *@

<div class="fab fab-flower fab-bottom-right">
    <!-- メイントリガー: Safariバグ対策でdivを使用 -->
    <div tabindex="0" role="button" class="btn btn-lg btn-primary btn-circle">
        <!-- + アイコン -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
    </div>

    <!-- メインアクション（新規予約） -->
    <button class="fab-main-action btn btn-circle btn-lg btn-success"
            @onclick="HandleNewAppointment"
            aria-label="新規予約">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
    </button>

    <!-- サブアクション（最大4つ） -->
    @foreach (var action in GetContextActions())
    {
        <div class="tooltip tooltip-left" data-tip="@action.Label">
            <button class="btn btn-lg btn-circle"
                    @onclick="() => ExecuteAction(action)"
                    aria-label="@action.Label">
                @((MarkupString)action.Icon)
            </button>
        </div>
    }
</div>

@code {
    [Parameter]
    public string CurrentView { get; set; } = "month";

    [Parameter]
    public EventCallback OnNewAppointment { get; set; }

    [Parameter]
    public EventCallback OnToggleFilter { get; set; }

    [Parameter]
    public EventCallback OnGoToToday { get; set; }

    [Parameter]
    public EventCallback OnPreviousPeriod { get; set; }

    [Parameter]
    public EventCallback OnNextPeriod { get; set; }

    [Parameter]
    public EventCallback<string> OnViewChange { get; set; }

    private async Task HandleNewAppointment()
    {
        await OnNewAppointment.InvokeAsync();
    }

    private async Task ExecuteAction(SpeedDialAction action)
    {
        await action.OnClick();
    }

    private record SpeedDialAction(string Label, string Icon, Func<Task> OnClick);

    private List<SpeedDialAction> GetContextActions()
    {
        // アイコンSVG定義
        var todayIcon = """<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle cx="12" cy="12" r="3" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2v2m0 16v2m10-10h-2M4 12H2m15.364-7.364l-1.414 1.414M7.05 16.95l-1.414 1.414m12.728 0l-1.414-1.414M7.05 7.05L5.636 5.636"/></svg>""";

        var filterIcon = """<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>""";

        var prevIcon = """<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>""";

        var weekIcon = """<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>""";

        var monthIcon = """<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>""";

        return CurrentView.ToLower() switch
        {
            "year" => new List<SpeedDialAction>
            {
                new("今日", todayIcon, async () => await OnGoToToday.InvokeAsync()),
                new("フィルター", filterIcon, async () => await OnToggleFilter.InvokeAsync()),
                new("前年", prevIcon, async () => await OnPreviousPeriod.InvokeAsync()),
            },
            "month" => new List<SpeedDialAction>
            {
                new("今日", todayIcon, async () => await OnGoToToday.InvokeAsync()),
                new("週表示", weekIcon, async () => await OnViewChange.InvokeAsync("week")),
                new("前月", prevIcon, async () => await OnPreviousPeriod.InvokeAsync()),
            },
            "week" => new List<SpeedDialAction>
            {
                new("今日", todayIcon, async () => await OnGoToToday.InvokeAsync()),
                new("月表示", monthIcon, async () => await OnViewChange.InvokeAsync("month")),
                new("前へ", prevIcon, async () => await OnPreviousPeriod.InvokeAsync()),
            },
            _ => new List<SpeedDialAction>
            {
                new("今日", todayIcon, async () => await OnGoToToday.InvokeAsync()),
            }
        };
    }
}
