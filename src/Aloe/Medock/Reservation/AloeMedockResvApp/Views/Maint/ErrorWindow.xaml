<Window x:Class="Aloe.Medock.Reservation.AloeMedockResvApp.Views.Maint.ErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.Views.Maint"
        xmlns:ui="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="例外"
        Width="640" Height="480"
        MinWidth="640" MinHeight="480"
        d:Width="640" d:Height="480"
        ResizeMode="CanResizeWithGrip"
>
    <Window.Resources>
        <Style TargetType="DockPanel">
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style TargetType="ui:PackIcon">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:PackIcon
            Grid.Row="0" Grid.Column="0"
            Kind="AlertCircle"
            Foreground="Crimson"
            Width="80" Height="80"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
        />
        <StackPanel Grid.Row="0" Grid.Column="1">
            <TextBlock>
                アプリケーションで、例外が発生しました。<LineBreak />
                [終了] をクリックすると、アプリケーションは直ちに終了します。<LineBreak />
                [報告] をクリックすると、エラーの内容を報告できます。<LineBreak />
            </TextBlock>
            <TextBlock x:Name="ErrorMessageTextBlock" TextWrapping="Wrap">
                {ex.Message}
            </TextBlock>
        </StackPanel>

        <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                   Margin="0, 8,0,0">
            <Button x:Name="OpenDetailButton" Click="OpenDetailButton_OnClick">
                <StackPanel Orientation="Horizontal" >
                    <ui:PackIcon Kind="ChevronDownBox" />
                    <TextBlock Text="Details" />
                </StackPanel>
            </Button>

            <Button x:Name="OpenReportButton" Click="OpenReportButton_OnClick">
                <StackPanel Orientation="Horizontal">
                    <ui:PackIcon Kind="EmailEdit"/>
                    <TextBlock Text="Reports" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <ScrollViewer Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Border BorderThickness="1"  Background="LightGray">
                            <TextBlock Text="詳細" />
                        </Border>
                    </Grid>
                    <RichTextBox x:Name="DetailsRichTextBox">
                        <RichTextBox.Document>
                            <FlowDocument>
                                <Paragraph>
                                    TODO: フォーマット
                                </Paragraph>
                                <Paragraph>
                                    Paragraph
                                </Paragraph>
                                <Paragraph>
                                    Paragraph
                                </Paragraph>
                            </FlowDocument>
                        </RichTextBox.Document>
                    </RichTextBox>
                </DockPanel>

                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Border BorderThickness="1" Background="LightGray">
                            <TextBlock Text="報告" />
                        </Border>
                    </Grid>
                    <Grid x:Name="ReportsGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" HorizontalContentAlignment="Right">Your Name:</Label>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="UserNameTextBox">{loginUser}</TextBox>

                        <Label Grid.Row="1" Grid.Column="0" HorizontalContentAlignment="Right">Your E-Mail:</Label>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="UserEmailTextBox">{loginUser Email}</TextBox>

                        <Label Grid.Row="2" Grid.Column="0" HorizontalContentAlignment="Right">Environment:</Label>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 x:Name="UserEnvironmentTextBox"
                                 MaxHeight="240"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Visible"
                        >{Environment}</TextBox>

                        <Label Grid.Row="3" Grid.Column="0" HorizontalContentAlignment="Right">Comment:</Label>
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 x:Name="UserCommentTextBox"
                                 MaxHeight="240"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Visible"
                        />

                        <Button Grid.Row="3" Grid.Column="2" x:Name="SendReportButton" VerticalAlignment="Bottom" Click="SendReportButton_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <ui:PackIcon Kind="Send"/>
                                <TextBlock Text="Send" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </DockPanel>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>
