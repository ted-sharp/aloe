<Window x:Class="Aloe.Medock.Reservation.AloeMedockResvApp.Views.Maint.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="ログ"
        Width="1920" Height="1080"
        MinWidth="640" MinHeight="480"
        d:Width="640" d:Height="480"
        ResizeMode="CanResizeWithGrip"
        Closing="LogWindow_OnClosing"
    >

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="4, 0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <WrapPanel
            DockPanel.Dock="Top"
        >
            <Label Content="LogLevel:" />
            <Button x:Name="SetTraceButton" ToolTip="Set Trace" Click="SetTraceButton_OnClick">
                <ui:PackIcon Kind="ShoePrint"/>
            </Button>
            <Button x:Name="SetDebugButton" ToolTip="Set Debug" Click="SetDebugButton_OnClick">
                <ui:PackIcon Kind="BugOutline"/>
            </Button>
            <Button x:Name="SetInfoButton" ToolTip="Set Info" Click="SetInfoButton_OnClick">
                <ui:PackIcon Kind="InfoCircleOutline"/>
            </Button>
            <Button x:Name="SetWarnButton" ToolTip="Set Warn" Click="SetWarnButton_OnClick">
                <ui:PackIcon Kind="Alert"/>
            </Button>

            <Label Content="MaxLines: " />
            <TextBox Text="1000" />
            <Button Content="Clear" />

            <Label Content="Find: " />
            <TextBox Text="find text" />
            <Button Content="Prev" />
            <Button Content="Next" />

            <Label Content="Mail: " />
            <Button ToolTip="Send mail">
                <ui:PackIcon Kind="Send"/>
            </Button>
        </WrapPanel>

        <RichTextBox
            DockPanel.Dock="Bottom"
            x:Name="LogRichTextBox"
            FontFamily="Consolas"
            Background="MidnightBlue"
            Foreground="LightGray"
            VerticalScrollBarVisibility="Auto"
        />
    </DockPanel>
</Window>
