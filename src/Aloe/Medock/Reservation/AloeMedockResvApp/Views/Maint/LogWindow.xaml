<Window
    x:Class="Aloe.Medock.Reservation.AloeMedockResvApp.Views.Maint.LogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bhv="http://schemas.aloe/wpf/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="ログ"
    Width="1920"
    Height="1080"
    MinWidth="640"
    MinHeight="480"
    bhv:OnEsc.EnableClose="True"
    d:Height="480"
    d:Width="640"
    Closing="LogWindow_OnClosing"
    Icon="/Assets/MaterialIcons/grass_24dp_75FB4C_FILL1_wght400_GRAD0_opsz24.ico"
    ResizeMode="CanResizeWithGrip"
    mc:Ignorable="d">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <WrapPanel DockPanel.Dock="Top">
            <Label Content="LogLevel:" />
            <Button
                x:Name="SetTraceButton"
                Click="SetTraceButton_OnClick"
                ToolTip="Set Trace">
                <ui:PackIcon Kind="ShoePrint" />
            </Button>
            <Button
                x:Name="SetDebugButton"
                Click="SetDebugButton_OnClick"
                ToolTip="Set Debug">
                <ui:PackIcon Kind="BugOutline" />
            </Button>
            <Button
                x:Name="SetInfoButton"
                Click="SetInfoButton_OnClick"
                ToolTip="Set Info">
                <ui:PackIcon Kind="InfoCircleOutline" />
            </Button>
            <Button
                x:Name="SetWarnButton"
                Click="SetWarnButton_OnClick"
                ToolTip="Set Warn">
                <ui:PackIcon Kind="Alert" />
            </Button>

            <Label Content="MaxLines: " />
            <TextBox Text="1000" />
            <Button Content="Clear" />

            <Label Content="Find: " />
            <TextBox Text="find text" />
            <Button Content="Prev" />
            <Button Content="Next" />

            <Label Content="Mail: " />
            <Button ToolTip="Send mail">
                <ui:PackIcon Kind="Send" />
            </Button>
        </WrapPanel>

        <RichTextBox
            x:Name="LogRichTextBox"
            Background="MidnightBlue"
            DockPanel.Dock="Bottom"
            FontFamily="Consolas"
            Foreground="LightGray"
            VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
