<UserControl
    x:Class="Aloe.Medock.Reservation.AloeMedockResvApp.Views.FunctionBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.ViewModels"
    d:Background="PaleGreen"
    d:DataContext="{d:DesignInstance Type=viewModels:FunctionBarViewModel}"
    d:DesignHeight="30"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="8" />
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Margin" Value="3,0,3,1" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3,0,3,1" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid ShowGridLines="false">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label
            Grid.Row="0"
            Grid.Column="3"
            HorizontalContentAlignment="Center"
            Content="ESC" />

        <Label
            Grid.Row="0"
            Grid.Column="5"
            HorizontalContentAlignment="Center"
            Content="F1" />
        <Label
            Grid.Row="0"
            Grid.Column="6"
            HorizontalContentAlignment="Center"
            Content="F2" />
        <Label
            Grid.Row="0"
            Grid.Column="7"
            HorizontalContentAlignment="Center"
            Content="F3" />
        <Label
            Grid.Row="0"
            Grid.Column="8"
            HorizontalContentAlignment="Center"
            Content="F4" />

        <Label
            Grid.Row="0"
            Grid.Column="10"
            HorizontalContentAlignment="Center"
            Content="F5" />
        <Label
            Grid.Row="0"
            Grid.Column="11"
            HorizontalContentAlignment="Center"
            Content="F6" />
        <Label
            Grid.Row="0"
            Grid.Column="12"
            HorizontalContentAlignment="Center"
            Content="F7" />
        <Label
            Grid.Row="0"
            Grid.Column="13"
            HorizontalContentAlignment="Center"
            Content="F8" />

        <Label
            Grid.Row="0"
            Grid.Column="15"
            HorizontalContentAlignment="Center"
            Content="F9" />
        <Label
            Grid.Row="0"
            Grid.Column="16"
            HorizontalContentAlignment="Center"
            Content="F10" />
        <Label
            Grid.Row="0"
            Grid.Column="17"
            HorizontalContentAlignment="Center"
            Content="F11" />
        <Label
            Grid.Row="0"
            Grid.Column="18"
            HorizontalContentAlignment="Center"
            Content="F12" />

        <ToggleButton
            Grid.Row="1"
            Grid.Column="1"
            Content="Alt"
            IsChecked="{Binding IsAltKeyPressed.Value, Mode=TwoWay}" />

        <Button
            Grid.Row="1"
            Grid.Column="3"
            Command="{Binding EscCommand}"
            Content="{Binding EscText.Value, Mode=OneWay}" />

        <Button
            Grid.Row="1"
            Grid.Column="5"
            Command="{Binding F1Command}"
            Content="{Binding F1Text.Value, Mode=OneWay}" />
        <Button
            Grid.Row="1"
            Grid.Column="6"
            Command="{Binding F2Command}"
            Content="{Binding F2Text.Value, Mode=OneWay}" />
        <Button
            Grid.Row="1"
            Grid.Column="7"
            Command="{Binding F3Command}"
            Content="{Binding F3Text.Value, Mode=OneWay}" />
        <Button
            Grid.Row="1"
            Grid.Column="8"
            Command="{Binding F4Command}"
            Content="{Binding F4Text.Value, Mode=OneWay}" />

        <Button
            Grid.Row="1"
            Grid.Column="10"
            Command="{Binding F5Command}"
            Content="{Binding F5Text.Value, Mode=OneWay}" />
        <Button
            Grid.Row="1"
            Grid.Column="11"
            Command="{Binding F6Command}"
            Content="{Binding F6Text.Value, Mode=OneWay}" />
        <Button
            Grid.Row="1"
            Grid.Column="12"
            Command="{Binding F7Command}"
            Content="{Binding F7Text.Value, Mode=OneWay}" />
        <Button
            Grid.Row="1"
            Grid.Column="13"
            Command="{Binding F8Command}"
            Content="{Binding F8Text.Value, Mode=OneWay}" />

        <Button
            Grid.Row="1"
            Grid.Column="15"
            Command="{Binding F9Command}"
            Content="{Binding F9Text.Value, Mode=OneWay}" />
        <Button
            Grid.Row="1"
            Grid.Column="16"
            Command="{Binding F10Command}"
            Content="{Binding F10Text.Value, Mode=OneWay}" />
        <Button
            Grid.Row="1"
            Grid.Column="17"
            Command="{Binding F11Command}"
            Content="{Binding F11Text.Value, Mode=OneWay}" />
        <Button
            Grid.Row="1"
            Grid.Column="18"
            Command="{Binding F12Command}"
            Content="{Binding F12Text.Value, Mode=OneWay}" />
    </Grid>
</UserControl>
