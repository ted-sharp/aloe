<Window x:Class="Aloe.Medock.Reservation.AloeMedockResvApp.Views.Resv.ReservationEquipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.Views.Resv"
        xmlns:vm="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.ViewModels"
        xmlns:behaviors="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.Views.Behaviors"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ReservationEquipViewModel}"
        behaviors:KeyInputBehavior.KeyDownCommand="{Binding FunctionBar.KeyDownCommand}"
        Title="設備予約" Height="450" Width="800"
        ResizeMode="CanResizeWithGrip">
    <DockPanel LastChildFill="True">
        <local:FunctionBar DockPanel.Dock="Bottom" DataContext="{Binding FunctionBar}" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Label>　</Label>
            <Label>予約月</Label>
            <TextBox
                IsEnabled="{Binding FunctionBar.SharedCanExecute.Value}"
                Text="{Binding StartMonth.Value}"
                MinWidth="80" />
        </StackPanel>

        <TabControl x:Name="EquipTabControl"
                    SelectionChanged="EquipTabControl_OnSelectionChanged"
                    IsEnabled="{Binding FunctionBar.SharedCanExecute.Value}"
                    ItemsSource="{Binding ReservationEquipTabItems}">

            <!-- TabItem ヘッダー部分 -->
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding EquipName}" />
                </DataTemplate>
            </TabControl.ItemTemplate>

            <!-- TabItem 中身 -->
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <local:ReservationEquipTabItem DataContext="{Binding .}"/>
                </DataTemplate>
            </TabControl.ContentTemplate>

            <!-- サンプル -->
            <TabItem Header="Sample" />
        </TabControl>
    </DockPanel>
</Window>
