<UserControl
    x:Class="Aloe.Medock.Reservation.AloeMedockResvApp.Views.Resv.ReservationEquipMonthlyGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvt="http://schemas.aloe/wpf/converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.ViewModels"
    d:Background="Azure"
    d:DataContext="{d:DesignInstance Type=vm:ReservationEquipTabItemViewModel}"
    d:DesignHeight="200"
    d:DesignWidth="400"
    DataContextChanged="ReservationEquipTabItem_OnDataContextChanged"
    mc:Ignorable="d">

    <UserControl.Resources>
        <cvt:StringContainsConverter x:Key="Contains土" Characters="土" />
        <cvt:StringContainsConverter x:Key="Contains日祝" Characters="日祝" />

        <!--  ローヘッダー: スロットを表示  -->
        <Style TargetType="DataGridRowHeader">
            <Setter Property="Content" Value="{Binding}" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock
                            Width="48"
                            d:DataContext="{d:DesignInstance Type=vm:BookingRow}"
                            Text="{Binding SlotDisplay, Mode=OneTime}"
                            TextAlignment="Center" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridCell">
            <Style.Triggers>
                <!--  "土" を含む場合だけ背景色 = LightBlue  -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=Column.Header, RelativeSource={RelativeSource Self}, Converter={StaticResource Contains土}}" Value="True" />
                        <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#2080C0FF" />
                </MultiDataTrigger>

                <!--  "日" または "祝" を含む場合だけ背景色 = LightPink  -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=Column.Header, RelativeSource={RelativeSource Self}, Converter={StaticResource Contains日祝}}" Value="True" />
                        <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#10FF8080" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!--<Style x:Key="StretchListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
        -->
        <!--  枠線と背景のためのBorder  -->
        <!--
                        <Border BorderBrush="Transparent" BorderThickness="0" Background="Transparent">
        -->
        <!--  ItemsControlを使ってデータを表示  -->
        <!--
                            <ItemsControl ItemsSource="{TemplateBinding Content}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>-->
    </UserControl.Resources>

    <DockPanel>
        <!--  TODO: キャプションがほしい  -->
        <ListBox
            x:Name="BookingOverflowListBox"
            DisplayMemberPath="DisplayText"
            DockPanel.Dock="Right" />

        <!--<ListView x:Name="BookingListView"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  SelectionMode="Extended"
                  Margin="0"
                  Padding="0"
                  ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
        >
            <ListView.View>
                <GridView x:Name="BookingGridView" />
            </ListView.View>
        </ListView>-->

        <!--  AlternatingRowBackground="{DynamicResource SystemControlBackgroundAltHighBrush}"  -->
        <DataGrid
            x:Name="BookingDataGrid"
            AlternatingRowBackground="#10FFFFFF"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserResizeColumns="False"
            CanUserResizeRows="False"
            CanUserSortColumns="False"
            ColumnHeaderHeight="24"
            ColumnWidth="160"
            Effect="{x:Null}"
            EnableColumnVirtualization="True"
            EnableRowVirtualization="True"
            HeadersVisibility="All"
            HorizontalScrollBarVisibility="Visible"
            MaxColumnWidth="160"
            MinColumnWidth="160"
            MinRowHeight="24"
            RowHeaderWidth="48"
            RowHeight="24"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.IsDeferredScrollingEnabled="False"
            SelectionMode="Extended"
            SelectionUnit="Cell"
            VerticalScrollBarVisibility="Visible"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling" />

    </DockPanel>
</UserControl>
