<UserControl x:Class="Aloe.Medock.Reservation.AloeMedockResvApp.Views.Resv.ReservationEquipMonthlyGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReservationEquipTabItemViewModel}"
             d:Background="Azure"
             d:DesignHeight="200" d:DesignWidth="400"
             DataContextChanged="ReservationEquipTabItem_OnDataContextChanged">

    <UserControl.Resources>
        <!-- ローヘッダー: スロットを表示 -->
        <Style TargetType="DataGridRowHeader">
            <Setter Property="Content" Value="{Binding}"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock
                            d:DataContext="{d:DesignInstance Type=vm:BookingRow}"
                            Width="48"
                            TextAlignment="Center"
                            Text="{Binding SlotDisplay, Mode=OneTime}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--<Style x:Key="StretchListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        --><!-- 枠線と背景のためのBorder --><!--
                        <Border BorderBrush="Transparent" BorderThickness="0" Background="Transparent">
                            --><!-- ItemsControlを使ってデータを表示 --><!--
                            <ItemsControl ItemsSource="{TemplateBinding Content}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>-->
    </UserControl.Resources>

    <DockPanel>
        <ListBox
            DockPanel.Dock="Right"
            x:Name="BookingOverflowListBox"
            DisplayMemberPath="DisplayText"
        />

        <!--<ListView x:Name="BookingListView"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  SelectionMode="Extended"
                  Margin="0"
                  Padding="0"
                  ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
        >
            <ListView.View>
                <GridView x:Name="BookingGridView" />
            </ListView.View>
        </ListView>-->

        <DataGrid
            x:Name="BookingDataGrid"
            AutoGenerateColumns="False"
            AlternatingRowBackground="GhostWhite"

            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserResizeRows="False"
            CanUserResizeColumns="False"
            CanUserSortColumns="False"

            EnableRowVirtualization="True"
            EnableColumnVirtualization="True"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
            VirtualizingPanel.ScrollUnit="Pixel"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.IsDeferredScrollingEnabled="False"

            HorizontalScrollBarVisibility="Visible"
            VerticalScrollBarVisibility="Visible"

            HeadersVisibility="All"
            RowHeaderWidth="48"
            MinRowHeight="24"
            RowHeight="24"

            ColumnHeaderHeight="24"
            MaxColumnWidth="160"
            MinColumnWidth="160"
            ColumnWidth="160"



            Effect="{x:Null}"

            SelectionUnit="Cell"
            SelectionMode="Extended">

        </DataGrid>


    </DockPanel>
</UserControl>
