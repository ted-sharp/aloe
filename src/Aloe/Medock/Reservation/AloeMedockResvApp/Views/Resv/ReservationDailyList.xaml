<UserControl x:Class="Aloe.Medock.Reservation.AloeMedockResvApp.Views.Resv.ReservationDailyList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReservationEquipTabItemViewModel}"
             d:Background="Azure"
             d:DesignHeight="200" d:DesignWidth="400">

    <UserControl.Resources>

    </UserControl.Resources>

    <DockPanel>
        <DataGrid
            x:Name="BookingDataGrid"
            AutoGenerateColumns="False"
            AlternatingRowBackground="GhostWhite"

            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserResizeRows="False"
            CanUserResizeColumns="False"
            CanUserSortColumns="False"

            EnableRowVirtualization="True"
            EnableColumnVirtualization="True"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
            VirtualizingPanel.ScrollUnit="Pixel"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.IsDeferredScrollingEnabled="False"

            HorizontalScrollBarVisibility="Visible"
            VerticalScrollBarVisibility="Visible"

            HeadersVisibility="All"
            RowHeaderWidth="48"
            MinRowHeight="24"
            RowHeight="24"

            ColumnHeaderHeight="24"
            MaxColumnWidth="160"
            MinColumnWidth="160"
            ColumnWidth="160"



            Effect="{x:Null}"

            SelectionUnit="Cell"
            SelectionMode="Extended">

        </DataGrid>

    </DockPanel>
</UserControl>
