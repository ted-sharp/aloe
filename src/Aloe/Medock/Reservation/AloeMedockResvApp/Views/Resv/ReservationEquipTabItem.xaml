<UserControl x:Class="Aloe.Medock.Reservation.AloeMedockResvApp.Views.Resv.ReservationEquipTabItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.Views.Resv"
             xmlns:vm="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReservationEquipTabItemViewModel}"
             d:Background="Azure"
             d:DesignHeight="200" d:DesignWidth="400"
             DataContextChanged="ReservationEquipTabItem_OnDataContextChanged">

    <UserControl.Resources>
        <!-- カラムヘッダー: 日付毎に表示 -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border BorderThickness="0,1,1,1" BorderBrush="Gray">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="Gray">
                                    <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock DockPanel.Dock="Left" Text="記号" HorizontalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Text="備考" HorizontalAlignment="Center" />
                                <Border DockPanel.Dock="Bottom" BorderThickness="1,0" BorderBrush="Gray">
                                    <TextBlock Text="氏名" HorizontalAlignment="Center" />
                                </Border>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ローヘッダー: スロットを表示 -->
        <Style TargetType="DataGridRowHeader">
            <!-- デザイナ上では ViewModel がそのまま渡っていますが、実際には ItemsSource の項目のひとつが渡ってきます。 -->
            <Setter Property="Content" Value="{Binding}"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock d:DataContext="{d:DesignInstance Type=vm:SlotRowData}"
                                   Text="{Binding Slot}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Red" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="LayoutGrid">
        <Grid.RowDefinitions>
            <!-- 上部のヘッダーを確保 -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- デザイナ上では DataRows の型が正常に解釈されていません。そのためデザイナではローヘッダーテンプレートへ渡す情報が不正確になっています。 -->
        <DataGrid Grid.Row="1"
                  x:Name="TabItemDataGrid"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserResizeRows="False"
                  HeadersVisibility="All"
                  SelectionUnit="Cell"
                  SelectionMode="Extended"
        />
    </Grid>
</UserControl>
