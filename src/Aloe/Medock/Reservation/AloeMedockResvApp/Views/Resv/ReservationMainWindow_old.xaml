<Window
    x:Class="Aloe.Medock.Reservation.AloeMedockResvApp.Views.Resv.ReservationMainWindow_old"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Aloe.Common.AloeCoreLib.Wpf.Behaviors;assembly=Aloe.Common.AloeCoreLib.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.Views.Resv"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.Views"
    xmlns:vm="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.ViewModels"
    Title="予約メイン"
    Width="800"
    Height="450"
    behaviors:Key.KeyDownCommand="{Binding FunctionBar.KeyDownCommand}"
    d:DataContext="{d:DesignInstance Type=vm:ReservationMainViewModel}"
    Loaded="ReservationMainWindow_old_OnLoaded"
    ResizeMode="CanResizeWithGrip"
    Unloaded="ReservationMainWindow_old_OnUnloaded"
    mc:Ignorable="d">
    <DockPanel LastChildFill="True">
        <views:FunctionBar DataContext="{Binding FunctionBar}" DockPanel.Dock="Bottom" />

        <Expander DockPanel.Dock="Top" IsExpanded="False">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <Label />
                    <Label>予約日</Label>
                    <TextBox MinWidth="80" Text="{Binding StartDate.Value}" />
                    <Label />
                    <CheckBox IsChecked="{Binding IsAutoRefresh.Value}">自動更新</CheckBox>
                    <TextBox MinWidth="40" Text="{Binding SecondsToRefresh.Value}" />
                    <Label>秒</Label>
                </StackPanel>
            </Expander.Header>
            <Expander.Content>
                <StackPanel Background="Azure">
                    <Label>Floor1</Label>
                    <Label>Floor2</Label>
                    <Label>月、火、水、木、金、土、日</Label>
                    <Label>AM、PM</Label>
                    <Label>その他条件など</Label>
                </StackPanel>
            </Expander.Content>
        </Expander>

        <Grid ShowGridLines="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Label
                Grid.Row="0"
                Grid.Column="0"
                Content="総合" />
            <ScrollViewer
                x:Name="ScrollViewer0"
                Grid.Row="0"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Visible"
                VerticalScrollBarVisibility="Hidden">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        x:Name="HeaderGrid0"
                        Grid.Row="0"
                        ShowGridLines="true">
                        <!--  下記定義はコードビハインドで動的に生成します。これは表示確認用のサンプルです。  -->
                        <Grid.ColumnDefinitions>
                            <!--  ルーム用(スペースのみ)  -->
                            <ColumnDefinition Width="40" />
                            <!--  AM/PM用(n個繰り返し)  -->
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="24" />
                            <!--  AM/PM用  -->
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="24" />
                            <!--  AM/PM用  -->
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <!--  日付用  -->
                            <RowDefinition Height="Auto" />
                            <!--  曜日用  -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!--  Width は DataGrid の AM/PM ヘッダーの ActualWidth にバインドします。  -->
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            HorizontalContentAlignment="Center"
                            Content="12/1" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            HorizontalContentAlignment="Center"
                            Content="火" />
                        <Label
                            Grid.Row="0"
                            Grid.Column="3"
                            Grid.ColumnSpan="2"
                            HorizontalContentAlignment="Center"
                            Content="12/2" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="3"
                            Grid.ColumnSpan="2"
                            HorizontalContentAlignment="Center"
                            Content="水" />
                        <Label
                            Grid.Row="0"
                            Grid.Column="5"
                            Grid.ColumnSpan="2"
                            HorizontalContentAlignment="Center"
                            Content="12/3" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="5"
                            Grid.ColumnSpan="2"
                            HorizontalContentAlignment="Center"
                            Content="木" />
                    </Grid>
                    <DataGrid
                        x:Name="BodyDataGrid0"
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserResizeRows="False"
                        HeadersVisibility="All"
                        ItemsSource="{Binding Schedules0.DefaultView, Mode=OneWay}" />
                </Grid>
            </ScrollViewer>

            <GridSplitter
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Height="5"
                HorizontalAlignment="Stretch"
                Background="Gray" />

            <Label
                Grid.Row="2"
                Grid.Column="0"
                Content="{Binding VerticalFloorName1}" />
            <ScrollViewer
                x:Name="ScrollViewer1"
                Grid.Row="2"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Visible"
                VerticalScrollBarVisibility="Hidden">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        x:Name="HeaderGrid1"
                        Grid.Row="0"
                        ShowGridLines="true" />
                    <DataGrid
                        x:Name="BodyDataGrid1"
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserResizeRows="False"
                        HeadersVisibility="All"
                        ItemsSource="{Binding Schedules1.DefaultView, Mode=OneWay}" />
                </Grid>
            </ScrollViewer>

            <GridSplitter
                Grid.Row="3"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Height="5"
                HorizontalAlignment="Stretch"
                Background="Gray" />

            <Label
                Grid.Row="4"
                Grid.Column="0"
                Content="{Binding VerticalFloorName2}" />
            <ScrollViewer
                x:Name="ScrollViewer2"
                Grid.Row="4"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Visible"
                VerticalScrollBarVisibility="Hidden">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        x:Name="HeaderGrid2"
                        Grid.Row="0"
                        ShowGridLines="true" />
                    <DataGrid
                        x:Name="BodyDataGrid2"
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserResizeRows="False"
                        HeadersVisibility="All"
                        ItemsSource="{Binding Schedules2.DefaultView, Mode=OneWay}" />
                </Grid>
            </ScrollViewer>
        </Grid>


    </DockPanel>
</Window>
