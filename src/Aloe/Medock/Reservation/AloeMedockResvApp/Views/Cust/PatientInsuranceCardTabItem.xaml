<UserControl
    x:Class="Aloe.Medock.Reservation.AloeMedockResvApp.Views.Cust.PatientInsuranceCardTabItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:vm="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.ViewModels"
    MinWidth="400"
    MinHeight="230"
    d:Background="PaleGreen"
    d:DataContext="{d:DesignInstance Type=vm:ReservationEquipTabItemViewModel}"
    d:DesignHeight="230"
    d:DesignWidth="400"
    DataContextChanged="ContactTabItem_OnDataContextChanged"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="ui:PackIcon">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="1" />
        </Style>
        <Style TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition
                Width="*"
                MinWidth="72"
                MaxWidth="120" />
            <ColumnDefinition
                Width="*"
                MinWidth="72"
                MaxWidth="120" />
            <ColumnDefinition
                Width="*"
                MinWidth="24"
                MaxWidth="40" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0">保険証</Label>
        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            Grid.ColumnSpan="6"
            HorizontalAlignment="Left">
            <CheckBox>主要</CheckBox>
        </StackPanel>

        <Label Grid.Row="1" Grid.Column="0">保険者(提供)</Label>
        <TextBox
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="3">
            123-1234
        </TextBox>
        <Button
            Grid.Row="1"
            Grid.Column="4"
            HorizontalAlignment="Left">
            <ui:PackIcon Kind="DotsHorizontal" />
        </Button>

        <Label Grid.Row="2" Grid.Column="0">保険者番号</Label>
        <TextBox
            Grid.Row="2"
            Grid.Column="1"
            Grid.ColumnSpan="3">
            12345678901234567890
        </TextBox>

        <StackPanel Grid.Row="3" Grid.Column="0">
            <Label>記号・番号・枝番</Label>
            <ui:PackIcon Kind="IdentificationCardOutline" />
        </StackPanel>
        <TextBox Grid.Row="3" Grid.Column="1">12345678</TextBox>
        <TextBox Grid.Row="3" Grid.Column="2">12345678</TextBox>
        <TextBox Grid.Row="3" Grid.Column="3">00</TextBox>
        <Button
            Grid.Row="3"
            Grid.Column="4"
            HorizontalAlignment="Left">
            <ui:PackIcon Kind="ContentCopy" />
        </Button>

        <StackPanel Grid.Row="4" Grid.Column="0">
            <Label>移行用 記号・番号・枝番</Label>
            <ui:PackIcon Kind="Import" />
        </StackPanel>
        <TextBox
            Grid.Row="4"
            Grid.Column="1"
            Grid.ColumnSpan="3">
            12345678 12345678 00
        </TextBox>

        <StackPanel Grid.Row="5" Grid.Column="0">
            <Label>被保険者名</Label>
            <ui:PackIcon Kind="AccountTie" />
        </StackPanel>
        <TextBox
            Grid.Row="5"
            Grid.Column="1"
            Grid.ColumnSpan="5">
            被保険者名
        </TextBox>

        <StackPanel Grid.Row="6" Grid.Column="0">
            <Label>本人家族区分</Label>
            <ui:PackIcon Kind="FamilyTree" />
        </StackPanel>
        <WrapPanel
            Grid.Row="6"
            Grid.Column="1"
            Grid.ColumnSpan="5">
            <RadioButton>なし</RadioButton>
            <RadioButton>本人</RadioButton>
            <RadioButton>家族</RadioButton>
        </WrapPanel>

        <StackPanel Grid.Row="7" Grid.Column="0">
            <Label>支援区分</Label>
            <ui:PackIcon Kind="CurrencyJpy" />
        </StackPanel>
        <WrapPanel
            Grid.Row="7"
            Grid.Column="1"
            Grid.ColumnSpan="5">
            <RadioButton>なし</RadioButton>
            <RadioButton>国保0割</RadioButton>
            <RadioButton>船員1割</RadioButton>
        </WrapPanel>

        <StackPanel Grid.Row="8" Grid.Column="0">
            <Label>継続区分</Label>
            <ui:PackIcon Kind="Update" />
        </StackPanel>
        <WrapPanel
            Grid.Row="8"
            Grid.Column="1"
            Grid.ColumnSpan="5">
            <RadioButton>なし</RadioButton>
            <RadioButton>継続療養</RadioButton>
            <RadioButton>任意継続</RadioButton>
        </WrapPanel>

        <StackPanel Grid.Row="9" Grid.Column="0">
            <Label>有効期間</Label>
            <ui:PackIcon Kind="CalendarRange" />
        </StackPanel>
        <WrapPanel
            Grid.Row="9"
            Grid.Column="1"
            Grid.ColumnSpan="5">
            <DatePicker />
            <Label>～</Label>
            <DatePicker />
        </WrapPanel>

        <StackPanel
            Grid.Row="10"
            Grid.Column="0"
            VerticalAlignment="Top">
            <Label>メモ</Label>
            <ui:PackIcon Kind="NoteTextOutline" />
        </StackPanel>
        <TextBox
            Grid.Row="10"
            Grid.Column="1"
            Grid.ColumnSpan="5"
            VerticalAlignment="Stretch"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Visible">
            {メモ}
        </TextBox>
    </Grid>
</UserControl>
