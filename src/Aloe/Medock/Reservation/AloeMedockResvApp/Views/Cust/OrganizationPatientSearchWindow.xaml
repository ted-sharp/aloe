<Window x:Class="Aloe.Medock.Reservation.AloeMedockResvApp.Views.Cust.OrganizationPatientSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.ViewModels"
        xmlns:behaviors="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.Views.Behaviors"
        xmlns:ui="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ReservationEquipViewModel}"
        behaviors:KeyInputBehavior.KeyDownCommand="{Binding FunctionBarVm.KeyDownCommand}"
        Title="団体 受診者 検索"
        Width="1920" Height="1080"
        d:Width="640" d:Height="480"
        ResizeMode="CanResizeWithGrip">

    <DockPanel LastChildFill="True">
        <views:InformationBar DockPanel.Dock="Bottom" DataContext="{Binding InformationBarVm}" />
        <views:FunctionBar DockPanel.Dock="Bottom" DataContext="{Binding FunctionBarVm}" />

        <Grid>
            <TabControl x:Name="EquipTabControl"
                        SelectionChanged="EquipTabControl_OnSelectionChanged"
                        IsEnabled="{Binding FunctionBarVm.SharedCanExecute.Value}"
                        ItemsSource="{Binding ReservationEquipTabItems}"
                        PreviewMouseWheel="EquipTabControl_OnPreviewMouseWheel"
            >
                <TabItem Header="団体">
                    <DataGrid />
                </TabItem>
                <TabItem Header="受診者">
                    <DataGrid />
                </TabItem>
            </TabControl>


            <Expander DockPanel.Dock="Top" IsExpanded="False">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <Label>　</Label>
                        <Label>企業</Label>
                        <Label>No.</Label>
                        <TextBox Text="{Binding StartDate.Value}" MinWidth="80" />
                        <Label>カナ</Label>
                        <TextBox Text="{Binding StartDate.Value}" MinWidth="80" />
                        <Label>Tel.</Label>
                        <TextBox Text="{Binding StartDate.Value}" MinWidth="80" />
                        <Label>/</Label>
                    </StackPanel>
                </Expander.Header>
                <Expander.Content>
                    <StackPanel Background="Azure">
                        <Label>Floor1</Label>
                        <Label>Floor2</Label>
                        <Label>月、火、水、木、金、土、日</Label>
                        <Label>AM、PM</Label>
                        <Label>その他条件など</Label>
                    </StackPanel>
                </Expander.Content>
            </Expander>

            <ui:Snackbar x:Name="Snackbar" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         MessageQueue="{Binding SnackbarMessageQueue}"/>
        </Grid>

    </DockPanel>
</Window>
