<UserControl x:Class="Aloe.Medock.Reservation.AloeMedockResvApp.Views.Cust.OrganizationBasicPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.Views.Cust"
             xmlns:ui="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <!-- 団体基本情報 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="80" MaxWidth="160" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="80" MaxWidth="160" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0">Sys. ID</Label>
        <TextBox Grid.Row="0" Grid.Column="1">12345678901234567890</TextBox>

        <Label Grid.Row="0" Grid.Column="2">保険者</Label>
        <TextBox Grid.Row="0" Grid.Column="3">12345678901234567890</TextBox>
        <Button Grid.Row="0" Grid.Column="4" HorizontalAlignment="Left">
            <ui:PackIcon Kind="DotsHorizontal"/>
        </Button>

        <Label Grid.Row="1" Grid.Column="0">団体 No.</Label>
        <TextBox Grid.Row="1" Grid.Column="1">12345678901234567890</TextBox>

        <Label Grid.Row="1" Grid.Column="2">親団体 No.</Label>
        <TextBox Grid.Row="1" Grid.Column="3">12345678901234567890</TextBox>
        <Button Grid.Row="1" Grid.Column="3" HorizontalAlignment="Right">
            <ui:PackIcon Kind="CloseCircle"/>
        </Button>
        <Button Grid.Row="1" Grid.Column="4" HorizontalAlignment="Left">
            <ui:PackIcon Kind="DotsHorizontal"/>
        </Button>

        <Label Grid.Row="2" Grid.Column="0">カナ</Label>
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4">12345678901234567890</TextBox>

        <Label Grid.Row="3" Grid.Column="0">名称</Label>
        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4">12345678901234567890</TextBox>

        <Label Grid.Row="4" Grid.Column="0">表示名</Label>
        <TextBox Grid.Row="4" Grid.Column="1">12345678901234567890</TextBox>

        <Label Grid.Row="4" Grid.Column="2">印字名</Label>
        <TextBox Grid.Row="4" Grid.Column="3">12345678901234567890</TextBox>

        <!-- 住所 -->
        <TabControl Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5" Margin="3">
            <!-- TabItem ヘッダー部分 -->
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding LocName}" />
                </DataTemplate>
            </TabControl.ItemTemplate>

            <!-- TabItem 中身 -->
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <local:LocationTabItem DataContext="{Binding .}" />
                </DataTemplate>
            </TabControl.ContentTemplate>

            <!-- サンプル -->
            <TabItem Header="Sample" />
            <TabItem Header="Sample2" />
            <TabItem Header="Sample3" />
        </TabControl>
    </Grid>

</UserControl>
