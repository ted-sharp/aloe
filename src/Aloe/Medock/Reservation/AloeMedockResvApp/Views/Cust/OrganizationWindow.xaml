<Window x:Class="Aloe.Medock.Reservation.AloeMedockResvApp.Views.Cust.OrganizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.Views.Cust"
        xmlns:vm="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.ViewModels"
        xmlns:behaviors="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.Views.Behaviors"
        xmlns:ui="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ReservationEquipViewModel}"
        behaviors:KeyInputBehavior.KeyDownCommand="{Binding FunctionBarVm.KeyDownCommand}"
        Title="団体"
        Width="1920" Height="1080"
        MinWidth="640" MinHeight="480"
        d:Width="1440" d:Height="1080"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style TargetType="ui:PackIcon">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="1" />
        </Style>
        <!--<Style TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>-->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="Red" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <views:InformationBar DockPanel.Dock="Bottom" DataContext="{Binding InformationBarVm}" />
        <views:FunctionBar DockPanel.Dock="Bottom" DataContext="{Binding FunctionBarVm}" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Label>団体 No.</Label>
            <TextBox Text="{Binding StartDate.Value}" MinWidth="80" />
        </StackPanel>

        <Grid>
            <!-- ここでTransformで拡大率を設定したい -->

            <Grid>
                <!-- 大まかに三分割する。(団体情報、マークやノート、契約情報) -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <!-- 団体基本情報 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="80" MaxWidth="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="80" MaxWidth="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0">Sys. ID</Label>
                        <TextBox Grid.Row="0" Grid.Column="1">12345678901234567890</TextBox>

                        <Label Grid.Row="0" Grid.Column="2">保険者</Label>
                        <TextBox Grid.Row="0" Grid.Column="3">12345678901234567890</TextBox>

                        <Label Grid.Row="1" Grid.Column="0">団体 No.</Label>
                        <TextBox Grid.Row="1" Grid.Column="1">12345678901234567890</TextBox>

                        <Label Grid.Row="2" Grid.Column="0">カナ</Label>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4">12345678901234567890</TextBox>

                        <Label Grid.Row="3" Grid.Column="0">名称</Label>
                        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4">12345678901234567890</TextBox>

                        <Label Grid.Row="4" Grid.Column="0">表示名</Label>
                        <TextBox Grid.Row="4" Grid.Column="1">12345678901234567890</TextBox>

                        <Label Grid.Row="4" Grid.Column="2">印字名</Label>
                        <TextBox Grid.Row="4" Grid.Column="3">12345678901234567890</TextBox>

                        <!-- 住所 -->
                        <TabControl Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5">
                            <!-- TabItem ヘッダー部分 -->
                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LocName}" />
                                </DataTemplate>
                            </TabControl.ItemTemplate>

                            <!-- TabItem 中身 -->
                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <local:LocationTabItem DataContext="{Binding .}" />
                                </DataTemplate>
                            </TabControl.ContentTemplate>

                            <!-- サンプル -->
                            <TabItem Header="Sample" />
                            <TabItem Header="Sample2" />
                            <TabItem Header="Sample3" />
                        </TabControl>
                    </Grid>
                </ScrollViewer>

                <GridSplitter Grid.Row="0" Grid.Column="1" Grid.RowSpan="1" />

                <!-- マークやノート -->
                <Grid Grid.Row="0" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0">マーク</Label>

                    <DataGrid
                        Grid.Row="1"
                        x:Name="MarkDataGrid"
                        AutoGenerateColumns="False"
                        AlternatingRowBackground="GhostWhite"

                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserResizeRows="False"
                        CanUserResizeColumns="False"
                        CanUserSortColumns="False"

                        EnableRowVirtualization="True"
                        EnableColumnVirtualization="True"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.IsDeferredScrollingEnabled="False"

                        HorizontalScrollBarVisibility="Visible"
                        VerticalScrollBarVisibility="Visible"

                        HeadersVisibility="All"
                        RowHeaderWidth="48"
                        MinRowHeight="24"
                        RowHeight="24"

                        ColumnHeaderHeight="24"
                        MaxColumnWidth="160"
                        MinColumnWidth="160"
                        ColumnWidth="160"



                        Effect="{x:Null}"

                        SelectionUnit="Cell"
                        SelectionMode="Extended">

                    </DataGrid>

                    <GridSplitter Grid.Row="2" />


                    <Label Grid.Row="3">ノート</Label>

                    <DataGrid
                        Grid.Row="4"
                        x:Name="NoteDataGrid"
                        AutoGenerateColumns="False"
                        AlternatingRowBackground="GhostWhite"

                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserResizeRows="False"
                        CanUserResizeColumns="False"
                        CanUserSortColumns="False"

                        EnableRowVirtualization="True"
                        EnableColumnVirtualization="True"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.IsDeferredScrollingEnabled="False"

                        HorizontalScrollBarVisibility="Visible"
                        VerticalScrollBarVisibility="Visible"

                        HeadersVisibility="All"
                        RowHeaderWidth="48"
                        MinRowHeight="24"
                        RowHeight="24"

                        ColumnHeaderHeight="24"
                        MaxColumnWidth="160"
                        MinColumnWidth="160"
                        ColumnWidth="160"



                        Effect="{x:Null}"

                        SelectionUnit="Cell"
                        SelectionMode="Extended">

                    </DataGrid>
                </Grid>

                <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" />

                <!-- 契約譲歩 -->
                <Grid Grid.Row="2" Grid.Column="0">

                </Grid>
            </Grid>



            <ui:Snackbar x:Name="Snackbar" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         MessageQueue="{Binding SnackbarMessageQueue}"/>
        </Grid>

    </DockPanel>
</Window>
