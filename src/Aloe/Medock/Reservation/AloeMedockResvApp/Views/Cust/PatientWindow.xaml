<Window x:Class="Aloe.Medock.Reservation.AloeMedockResvApp.Views.Cust.PatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.Views.Cust"
        xmlns:vm="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.ViewModels"
        xmlns:ui="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.Views"
        xmlns:bhv="http://schemas.aloe/wpf/behaviors"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ReservationEquipViewModel}"
        bhv:Key.KeyDownCommand="{Binding FunctionBarVm.KeyDownCommand}"
        Title="個人"
        Width="640" Height="1080"
        MinWidth="640" MinHeight="480"
        d:Width="640" d:Height="1080"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style TargetType="ui:PackIcon">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="1" />
        </Style>
        <!--<Style TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>-->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="Red" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <views:InformationBar DockPanel.Dock="Bottom" DataContext="{Binding InformationBarVm}" />
        <views:FunctionBar DockPanel.Dock="Bottom" DataContext="{Binding FunctionBarVm}" />

        <Border
                DockPanel.Dock="Top"
                BorderThickness="1"
                BorderBrush="Black"
                CornerRadius="3"
                Padding="3"
                Margin="3"
            >
            <local:PatientBar />
        </Border>

        <Grid>
            <!-- ここでTransformで拡大率を設定したい -->

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TabControl>
                    <TabItem Header="患者基本情報">
                        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <local:PatientBasicPanel />
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="やりとり">

                    </TabItem>

                    <TabItem Header="ファイル">

                    </TabItem>

                    <TabItem Header="オーダー">

                    </TabItem>

                    <TabItem Header="受付">

                    </TabItem>

                    <TabItem Header="予約">

                    </TabItem>

                </TabControl>

            </Grid>



            <ui:Snackbar x:Name="Snackbar" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         MessageQueue="{Binding SnackbarMessageQueue}"/>
        </Grid>

    </DockPanel>
</Window>
