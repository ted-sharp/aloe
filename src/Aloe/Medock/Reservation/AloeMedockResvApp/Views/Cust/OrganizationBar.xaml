<UserControl x:Class="Aloe.Medock.Reservation.AloeMedockResvApp.Views.Cust.OrganizationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.Views.Cust"
             xmlns:ui="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:Background="PaleGreen"
             d:DesignHeight="80"
             d:DesignWidth="800">

    <DockPanel>
        <Grid DockPanel.Dock="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:PackIcon Grid.Row="0" Grid.Column="0" Kind="History" />
            <TextBlock Grid.Row="0" Grid.Column="1">yyyy/MM/dd HH:mm:ss by user</TextBlock>
            <ui:PackIcon Grid.Row="1" Grid.Column="0" Kind="Key" />
            <TextBlock Grid.Row="1" Grid.Column="1">yyyy/MM/dd HH:mm:ss by user</TextBlock>
        </Grid>

        <Grid DockPanel.Dock="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0">団体 No.</TextBlock>
            <ui:PackIcon Grid.Row="0" Grid.Column="1" Kind="Numeric" />
            <TextBox Grid.Row="0" Grid.Column="2" MinWidth="80" />

            <ui:PackIcon Grid.Row="1" Grid.Column="1" Kind="OfficeBuildingOutline" />
            <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="7">{FullName}</TextBlock>

            <ui:PackIcon Grid.Row="2" Grid.Column="1" Kind="MapMarkerRadiusOutline" />
            <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2">{Address}</TextBlock>
            <ui:PackIcon Grid.Row="2" Grid.Column="4" Kind="Telephone" />
            <TextBlock Grid.Row="2" Grid.Column="5">{Phone}</TextBlock>
            <ui:PackIcon Grid.Row="2" Grid.Column="6" Kind="EMail" />
            <TextBlock Grid.Row="2" Grid.Column="7">{Mail}</TextBlock>

            <ui:PackIcon Grid.Row="3" Grid.Column="1" Kind="NoteTextOutline" />
            <TextBlock Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="7">{Memo}</TextBlock>
        </Grid>
    </DockPanel>
</UserControl>
