<UserControl x:Class="Aloe.Medock.Reservation.AloeMedockResvApp.Views.Cust.OrganizationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Aloe.Medock.Reservation.AloeMedockResvApp.Views.Cust"
             xmlns:ui="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:Background="PaleGreen"
             d:DesignHeight="80"
             d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Margin" Value="3,0,3,1" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3,0,3,1" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:PackIcon Grid.Row="0" Grid.Column="0" Kind="History" />
            <TextBlock Grid.Row="0" Grid.Column="1">yyyy/MM/dd HH:mm:ss by user</TextBlock>
            <ui:PackIcon Grid.Row="1" Grid.Column="0" Kind="Key" />
            <TextBlock Grid.Row="1" Grid.Column="1">yyyy/MM/dd HH:mm:ss by user</TextBlock>
        </Grid>

        <Grid DockPanel.Dock="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0">団体 No.</TextBlock>
            <ui:PackIcon Grid.Row="0" Grid.Column="1" Kind="Numeric" />
            <TextBox Grid.Row="0" Grid.Column="2" MinWidth="80" />

            <ui:PackIcon Grid.Row="1" Grid.Column="1" Kind="OfficeBuildingOutline" />
            <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2">{FullName}</TextBlock>

            <ui:PackIcon Grid.Row="2" Grid.Column="1" Kind="MapMarkerRadiusOutline" Height="11" />
            <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" FontSize="9">{Address}</TextBlock>

            <ui:PackIcon Grid.Row="3" Grid.Column="1" Kind="Telephone" Height="11" />
            <Grid Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="9">{Phone}</TextBlock>
                <ui:PackIcon Grid.Column="1" Kind="EMail" Height="11" />
                <TextBlock Grid.Column="2" FontSize="9">{Mail}</TextBlock>
            </Grid>

            <ui:PackIcon Grid.Row="4" Grid.Column="1" Kind="NoteTextOutline" />
            <TextBlock Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2">{Memo}</TextBlock>
        </Grid>
    </DockPanel>
</UserControl>
