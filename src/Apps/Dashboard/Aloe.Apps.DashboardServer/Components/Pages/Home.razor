@page "/"

<PageTitle>Dashboard</PageTitle>

<main class="container">
    <hgroup>
        <h1>Dashboard</h1>
        <p>OpenTelemetry ビューアー</p>
    </hgroup>

    <div class="grid">
        <a href="/otel/traces" role="button" class="outline">
