@page "/otel/logs"
@rendermode InteractiveServer
@using Aloe.Apps.DashboardLib.OtelViewer.Models
@using Aloe.Apps.DashboardLib.OtelViewer.Storage
@using Microsoft.JSInterop
@inject IOtelStore OtelStore
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>OTel ログ</PageTitle>

<main class="container">
    <nav>
        <hgroup>
            <h1>OTel ログビューアー</h1>
            <p>OpenTelemetry ログレコードを表示します</p>
        </hgroup>
        <button class="icon-button" @onclick="NavigateToHome" title="閉じる">
            <i data-lucide="x"></i>
        </button>
    </nav>

    <article>
        <form @onsubmit="ApplyFilters">
            <div class="grid">
                <label>
                    サービス名
                    <select @bind="selectedService">
                        <option value="">すべて</option>
                        @foreach (var name in serviceNames)
                        {
                            <option value="@name">@name</option>
                        }
                    </select>
                </label>

                <label>
                    重大度
                    <select @bind="selectedSeverity">
                        <option value="">すべて</option>
                        <option value="TRACE">TRACE</option>
                        <option value="DEBUG">DEBUG</option>
                        <option value="INFO">INFO</option>
                        <option value="WARN">WARN</option>
                        <option value="ERROR">ERROR</option>
                        <option value="FATAL">FATAL</option>
                    </select>
                </label>

                <label>
                    TraceID
                    <input type="text" @bind="filterTraceId" placeholder="トレースIDで絞り込み" />
                </label>
            </div>

            <div class="grid">
                <label>
                    開始日時
                    <input type="datetime-local" @bind="startTime" />
                </label>

                <label>
                    終了日時
                    <input type="datetime-local" @bind="endTime" />
                </label>

                <div>
                    <button type="submit"><i data-lucide="filter"></i>フィルター適用</button>
                </div>
            </div>
        </form>
    </article>

    @if (logs.Count == 0)
    {
        <article>
            <p>ログレコードがありません</p>
        </article>
    }
    else
    {
        <article>
            <div class="table-overflow">
                <table>
                    <thead>
                        <tr>
                            <th>タイムスタンプ</th>
                            <th>サービス</th>
                            <th>重大度</th>
                            <th>メッセージ</th>
                            <th>TraceID</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in logs)
                        {
                            <tr @onclick="() => ToggleExpand(log)" style="cursor: pointer;">
                                <td>@log.Timestamp.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss.fff")</td>
                                <td><small>@log.ServiceName</small></td>
                                <td>
                                    <span class="status-badge @GetSeverityBadgeClass(log.Severity)">
                                        @log.Severity
                                    </span>
                                </td>
                                <td style="max-width: 400px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    @log.Body
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(log.TraceId))
                                    {
                                        <a href="/otel/traces/@log.TraceId">
                                            <small>@log.TraceId[..Math.Min(8, log.TraceId.Length)]…</small>
                                        </a>
                                    }
                                </td>
                            </tr>
                            @if (expandedLog == log)
                            {
                                <tr>
                                    <td colspan="5">
                                        <details open>
                                            <summary>属性</summary>
                                            @if (log.Attributes.Count > 0)
                                            {
                                                <table>
                                                    @foreach (var attr in log.Attributes)
                                                    {
                                                        <tr>
                                                            <td><strong>@attr.Key</strong></td>
                                                            <td>@attr.Value</td>
                                                        </tr>
                                                    }
                                                </table>
                                            }
                                            else
                                            {
                                                <p><small>属性なし</small></p>
                                            }
                                            @if (!string.IsNullOrEmpty(log.Body))
                                            {
                                                <h6>メッセージ全文</h6>
                                                <pre>@log.Body</pre>
                                            }
                                        </details>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <nav aria-label="ページネーション">
                    <div role="group" style="display: flex; justify-content: center; align-items: center; gap: 0.5rem;">
                        @if (currentPage > 1)
                        {
                            <button @onclick="() => ChangePage(currentPage - 1)"><i data-lucide="chevron-left"></i>前へ</button>
                        }
                        <span>ページ @currentPage / @totalPages（全 @totalCount 件）</span>
                        @if (currentPage < totalPages)
                        {
                            <button @onclick="() => ChangePage(currentPage + 1)">次へ<i data-lucide="chevron-right"></i></button>
                        }
                    </div>
                </nav>
            }
        </article>
    }
</main>

@code {
    private List<OtelLogRecord> logs = new();
    private List<string> serviceNames = new();
    private string selectedService = "";
    private string selectedSeverity = "";
    private string filterTraceId = "";
    private DateTime? startTime;
    private DateTime? endTime;
    private int currentPage = 1;
    private int pageSize = 50;
    private int totalCount = 0;
    private int totalPages = 0;
    private OtelLogRecord? expandedLog;

    protected override void OnInitialized()
    {
        serviceNames = OtelStore.GetServiceNames().ToList();
        LoadLogs();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("lucide.createIcons"); } catch { }
    }

    private void NavigateToHome() => NavigationManager.NavigateTo("/");

    private void LoadLogs()
    {
        var from = startTime.HasValue ? new DateTimeOffset(startTime.Value, TimeSpan.Zero) : (DateTimeOffset?)null;
        var to = endTime.HasValue ? new DateTimeOffset(endTime.Value, TimeSpan.Zero) : (DateTimeOffset?)null;
        var service = string.IsNullOrEmpty(selectedService) ? null : selectedService;
        var severity = string.IsNullOrEmpty(selectedSeverity) ? null : selectedSeverity;
        var traceId = string.IsNullOrEmpty(filterTraceId) ? null : filterTraceId;

        var skip = (currentPage - 1) * pageSize;
        logs = OtelStore.QueryLogs(service, severity, traceId, from, to, skip, pageSize).ToList();
        totalCount = OtelStore.CountLogs(service, severity, traceId, from, to);
        totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
        serviceNames = OtelStore.GetServiceNames().ToList();
    }

    private void ApplyFilters()
    {
        currentPage = 1;
        LoadLogs();
    }

    private void ChangePage(int page)
    {
        currentPage = page;
        LoadLogs();
    }

    private void ToggleExpand(OtelLogRecord log)
    {
        expandedLog = expandedLog == log ? null : log;
    }

    private static string GetSeverityBadgeClass(string severity) => severity.ToUpperInvariant() switch
    {
        "ERROR" or "FATAL" => "status-badge-stopped",
        "WARN" => "status-badge-paused",
        "INFO" => "status-badge-running",
        _ => "",
    };
}
