@inherits LayoutComponentBase

<div class="drawer lg:drawer-open responsive-container">
    <!-- ドロワートグル（モバイル用） -->
    <input id="main-drawer" type="checkbox" class="drawer-toggle" />
    
    <!-- メインコンテンツ -->
    <div class="drawer-content flex flex-col min-h-screen">
        <!-- ナビゲーションバー -->
        <nav class="navbar bg-base-100 shadow-md sticky top-0 z-50">
            <div class="flex-none lg:hidden">
                <label for="main-drawer" class="btn btn-square btn-ghost drawer-toggle-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-6 h-6 stroke-current">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </label>
            </div>
            <div class="flex-1 px-2">
                <a href="/" class="btn btn-ghost text-xl font-bold text-emerald-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                    Aloe Medock
                </a>
            </div>
            <div class="flex-none gap-2 items-center">
                <!-- テーマ切り替え -->
                <label class="swap swap-rotate btn btn-ghost btn-circle">
                    <input type="checkbox" class="theme-controller" value="dark" />
                    <svg class="swap-off h-6 w-6 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"/>
                    </svg>
                    <svg class="swap-on h-6 w-6 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"/>
                    </svg>
                </label>
                <!-- ユーザーメニュー -->
                <UserAvatarFab
                    UserInitial="@(userContext?.Initial ?? "U")"
                    UserDisplayName="@(userContext?.UserDisplayName ?? "")"
                    UserEmail="@(userContext?.Email ?? "")"
                    TenantName="@(userContext?.TenantName ?? "")"
                    FacilityName="@(userContext?.FacilityName ?? "")"
                    UserRole="@(userContext?.IsSystemAdmin == true ? "システム管理者" : userContext?.IsFacilityAdmin == true ? "施設管理者" : "")"
                    CurrentFacilityId="@userContext?.FacilityId"
                    HasMultipleFacilities="@hasMultipleFacilities"
                    AvailableFacilities="@availableFacilities"
                    OnLogout="HandleLogout"
                    OnFacilitySwitch="HandleFacilitySwitch" />
            </div>
        </nav>
        
        <!-- ページコンテンツ -->
        <main class="flex-1 p-4 md:p-6">
            @Body
        </main>
        
        <!-- フッター -->
        <footer class="footer footer-center p-4 bg-base-300 text-base-content">
            <aside>
                <p>© 2025 Aloe Medock - Medical Reservation System</p>
            </aside>
        </footer>
    </div>
    
    <!-- サイドバー -->
    <div class="drawer-side z-40">
        <label for="main-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
        <aside class="menu bg-base-100 w-64 min-h-full p-4 shadow-lg sidebar-visible">
            <!-- サイドバーヘッダー -->
            <div class="mb-6 flex items-center gap-2 px-2">
                <div class="w-10 h-10 rounded-full bg-emerald-500 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </div>
                <div>
                    <h2 class="font-bold text-lg">メニュー</h2>
                    <p class="text-xs text-base-content/60">予約管理システム</p>
                </div>
            </div>
            
            <!-- ナビゲーションリンク -->
            <ul class="space-y-1">
                <li>
                    <a href="/" class="flex items-center gap-3 hover:bg-emerald-100 active:bg-emerald-200">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                        </svg>
                        ホーム
                    </a>
                </li>
                <li>
                    <details open>
                        <summary class="flex items-center gap-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            予約管理
                        </summary>
                        <ul class="pl-4 mt-1">
                            <li><a href="/calendar">カレンダー</a></li>
                            <li><a href="/appointments">予約一覧</a></li>
                            <li><a href="/appointments/new">新規予約</a></li>
                        </ul>
                    </details>
                </li>
                <li>
                    <details>
                        <summary class="flex items-center gap-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                            </svg>
                            患者管理
                        </summary>
                        <ul class="pl-4 mt-1">
                            <li><a href="/patients">患者一覧</a></li>
                            <li><a href="/patients/new">新規登録</a></li>
                        </ul>
                    </details>
                </li>
                <li>
                    <details>
                        <summary class="flex items-center gap-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                            </svg>
                            団体管理
                        </summary>
                        <ul class="pl-4 mt-1">
                            <li><a href="/organizations">団体一覧</a></li>
                            <li><a href="/organizations/new">新規登録</a></li>
                        </ul>
                    </details>
                </li>
            </ul>
            
            <!-- 区切り線 -->
            <div class="divider my-4"></div>
            
            <!-- 管理メニュー -->
            <ul class="space-y-1">
                <li>
                    <a href="/settings" class="flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        設定
                    </a>
                </li>
            </ul>
        </aside>
    </div>
</div>

<!-- エラー表示 -->
<div id="blazor-error-ui" class="fixed bottom-0 left-0 right-0 z-50 hidden" data-nosnippet>
    <div class="alert alert-error shadow-lg m-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>エラーが発生しました。</span>
        <div>
            <a href="." class="btn btn-sm btn-ghost">再読み込み</a>
            <button class="btn btn-sm btn-ghost dismiss">閉じる</button>
        </div>
    </div>
</div>

