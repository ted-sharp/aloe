@* 長押しボトムシート（予約作成 / 仮予約作成） *@

<div class="modal modal-bottom @(IsOpen ? "modal-open" : "")" role="dialog">
    <div class="modal-box rounded-t-2xl rounded-b-none">
        <div class="text-center text-sm text-base-content/60 mb-4">
            @if (SelectedDate.HasValue)
            {
                @SelectedDate.Value.ToString("M月d日（ddd）", new System.Globalization.CultureInfo("ja-JP"))
            }
        </div>

        <div class="flex flex-col gap-3">
            <button class="btn btn-primary w-full" @onclick="HandleCreateAppointment">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                予約を作成
            </button>
            <button class="btn btn-outline w-full" @onclick="HandleCreateTentative">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                仮予約を作成
            </button>
        </div>

        <button class="btn btn-ghost w-full mt-2" @onclick="HandleClose">キャンセル</button>
    </div>
    <div class="modal-backdrop" @onclick="HandleClose"></div>
</div>
