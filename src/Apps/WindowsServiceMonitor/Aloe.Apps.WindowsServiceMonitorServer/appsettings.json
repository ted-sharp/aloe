{
  "Authentication": {
    "Password": "password123",
    "CookieSettings": {
      "ExpireTimeMinutes": 60,
      "SlidingExpiration": true
    }
  },
  "WindowsServiceMonitor": {
    "MonitoredServices": [],
    "MonitoredServicesPath": "monitored-services.json",
    "PollingIntervalSeconds": 5,
    "EnableAutoRefresh": true,
    "RequireAdminForControl": true
  },
  "AllowedHosts": "*",
  "AppLogs": [
    {
      "Name": "FileBridge",
      "LogDirectory": "C:\\Services\\FileBridge\\logs",
      "FilePattern": "filebridge_app-*.log"
    }
  ]
}
