@* モバイル用フルスクリーン予約作成モーダル *@
@using Aloe.Apps.MedockServer.Components.Calendar

<div class="modal @(IsOpen ? "modal-open" : "")" role="dialog">
    <div class="modal-box w-full h-full max-w-full max-h-full rounded-none flex flex-col p-0">
        <!-- ヘッダー -->
        <div class="flex items-center justify-between px-4 py-3 bg-primary text-primary-content flex-shrink-0">
            <button class="btn btn-ghost btn-sm text-primary-content" @onclick="HandleClose">
                キャンセル
            </button>
            <span class="font-bold">
                @(IsEditMode ? "予約編集" : InitialStatus == 1 ? "仮予約作成" : "予約作成")
            </span>
            <button class="btn btn-ghost btn-sm text-primary-content"
                    @onclick="HandleSubmit"
                    disabled="@_isProcessing">
                @(_isProcessing ? "保存中..." : "保存")
            </button>
        </div>

        <!-- エラー表示 -->
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-error rounded-none">
                <span class="text-sm">@_errorMessage</span>
            </div>
        }

        <!-- フォーム本体 -->
        <div class="flex-1 overflow-y-auto p-4 flex flex-col gap-4">
            <!-- 日付 -->
            <div class="form-control">
                <label class="label"><span class="label-text font-semibold">日付</span></label>
                <input type="date" class="input input-bordered w-full"
                       value="@_formDate.ToString("yyyy-MM-dd")"
                       @onchange="HandleDateChange" />
            </div>

            <!-- 時間 -->
            <div class="form-control">
                <label class="label"><span class="label-text font-semibold">開始時間</span></label>
                <select class="select select-bordered w-full"
                        value="@_startTimeString"
                        @onchange="HandleTimeChange">
                    @foreach (var slot in _timeSlots)
                    {
                        <option value="@slot">@slot</option>
                    }
                </select>
            </div>

            <!-- ステータス -->
            <div class="form-control">
                <label class="label"><span class="label-text font-semibold">種別</span></label>
                <div class="join w-full">
                    <button class="btn join-item flex-1 @(_status == 0 ? "btn-primary" : "btn-outline")"
                            @onclick="() => _status = 0">
                        予約
                    </button>
                    <button class="btn join-item flex-1 @(_status == 1 ? "btn-primary" : "btn-outline")"
                            @onclick="() => _status = 1">
                        仮予約
                    </button>
                </div>
            </div>

            <!-- 患者名 -->
            <div class="form-control">
                <label class="label">
                    <span class="label-text font-semibold">患者名</span>
                    <span class="label-text-alt text-base-content/50">仮予約は省略可</span>
                </label>
                <input type="text" class="input input-bordered w-full"
                       placeholder="患者名を入力"
                       @bind="_patientName" />
            </div>

            <!-- メモ -->
            <div class="form-control">
                <label class="label"><span class="label-text font-semibold">メモ</span></label>
                <textarea class="textarea textarea-bordered w-full" rows="3"
                          placeholder="メモを入力"
                          @bind="_memo"></textarea>
            </div>
        </div>
    </div>
</div>
