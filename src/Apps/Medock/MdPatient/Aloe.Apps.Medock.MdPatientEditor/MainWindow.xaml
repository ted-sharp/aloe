<Window x:Class="Aloe.Apps.Medock.MdPatientEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="患者編集" Height="550" Width="700">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="患者コード" FontWeight="Bold" Margin="0,5" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PtCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="カルテコード" FontWeight="Bold" Margin="0,5" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding KarteCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="患者名" FontWeight="Bold" Margin="0,5" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PtName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="カタカナ" FontWeight="Bold" Margin="0,5" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PtNameKatakana, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="旧姓名" FontWeight="Bold" Margin="0,5" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PtMaidenName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="別名" FontWeight="Bold" Margin="0,5" VerticalAlignment="Center" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding PtAliasName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="生年月日" FontWeight="Bold" Margin="0,5" VerticalAlignment="Center" />
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding BirthDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />

                <TextBlock Grid.Row="7" Grid.Column="0" Text="性別コード" FontWeight="Bold" Margin="0,5" VerticalAlignment="Center" />
                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding SexCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Width="60" HorizontalAlignment="Left" />

                <TextBlock Grid.Row="8" Grid.Column="0" Text="メモ" FontWeight="Bold" Margin="0,5" VerticalAlignment="Top" />
                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding PtMemo, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto" />
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
            <TextBlock Text="{Binding StatusMessage}" Foreground="Green" VerticalAlignment="Center" Margin="0,0,15,0" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" VerticalAlignment="Center" Margin="0,0,15,0" />
            <Button Content="保存" Command="{Binding SaveCommand}" Width="100" FontSize="14" />
        </StackPanel>
    </Grid>
</Window>
