<Window x:Class="Aloe.Apps.Medock.MdPatientFinder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="患者検索" Height="600" Width="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 検索バー -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                     Width="400" Margin="0,0,10,0" VerticalContentAlignment="Center"
                     FontSize="14" />
            <Button Content="検索" Command="{Binding SearchCommand}"
                    Width="80" FontSize="14" />
        </StackPanel>

        <!-- 検索結果 DataGrid -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Patients}"
                  SelectedItem="{Binding SelectedPatient}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="患者コード" Binding="{Binding PtCode}" Width="120" />
                <DataGridTextColumn Header="患者名" Binding="{Binding PtName}" Width="150" />
                <DataGridTextColumn Header="カタカナ" Binding="{Binding PtNameKatakana}" Width="150" />
                <DataGridTextColumn Header="生年月日" Binding="{Binding BirthDate}" Width="110" />
                <DataGridTextColumn Header="性別" Binding="{Binding SexCode}" Width="60" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- ステータスバー -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} 件'}" Margin="0,0,20,0"
                       FontSize="13" VerticalAlignment="Center" />
            <Button Content="閲覧" Command="{Binding OpenViewerCommand}"
                    Width="80" Margin="0,0,10,0" FontSize="13" />
            <Button Content="編集" Command="{Binding OpenEditorCommand}"
                    Width="80" FontSize="13" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                       Margin="20,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
