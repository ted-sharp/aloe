{
  "AllowedHosts": "*",
  "XAdES": {
    "UseDevCertificate": true,
    "TimestampServerUrl": "http://localhost:8318/",
    "EnableTimestamp": true,
    "OutputPath": "signatures",
    "MaxSignatureAgeMins": 1440
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://localhost:5081",
        "Protocols": "Http2"
      }
    }
  }
}
