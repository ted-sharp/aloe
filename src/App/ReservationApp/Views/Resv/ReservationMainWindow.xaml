<Window x:Class="AloeReservationGrid.App.ReservationApp.Views.Resv.ReservationMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AloeReservationGrid.App.ReservationApp.Views.Resv"
        xmlns:vm="clr-namespace:AloeReservationGrid.App.ReservationApp.ViewModels"
        xmlns:behaviors="clr-namespace:AloeReservationGrid.App.ReservationApp.Views.Behaviors"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ReservationMainViewModel}"
        behaviors:KeyInputBehavior.KeyDownCommand="{Binding FunctionBar.KeyDownCommand}"
        Title="予約メイン" Height="450" Width="800"
        ResizeMode="CanResizeWithGrip">
    <DockPanel LastChildFill="True">
        <local:FunctionBar DockPanel.Dock="Bottom" DataContext="{Binding FunctionBar}" />

        <Expander DockPanel.Dock="Top" IsExpanded="False">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <Label>　</Label>
                    <Label>予約日</Label>
                    <TextBox Text="{Binding StartDate.Value}" MinWidth="80" />
                    <Label>　</Label>
                    <CheckBox IsChecked="{Binding IsAutoRefresh.Value}">自動更新</CheckBox>
                    <TextBox Text="{Binding SecondsToRefresh.Value}" MinWidth="40" />
                    <Label>秒</Label>
                </StackPanel>
            </Expander.Header>
            <Expander.Content>
                <StackPanel Background="Azure">
                    <Label>Floor1</Label>
                    <Label>Floor2</Label>
                    <Label>月、火、水、木、金、土、日</Label>
                    <Label>AM、PM</Label>
                    <Label>その他条件など</Label>
                </StackPanel>
            </Expander.Content>
        </Expander>

        <Grid ShowGridLines="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="総合" />
            <ScrollViewer Grid.Row="0" Grid.Column="1" x:Name="ScrollViewer0"
                HorizontalScrollBarVisibility="Visible"
                VerticalScrollBarVisibility="Hidden">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" x:Name="HeaderGrid0" ShowGridLines="true">
                        <!-- 下記定義はコードビハインドで動的に生成します。これは表示確認用のサンプルです。 -->
                        <Grid.ColumnDefinitions>
                            <!-- ルーム用(スペースのみ) -->
                            <ColumnDefinition Width="40" />
                            <!-- AM/PM用(n個繰り返し) -->
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="24" />
                            <!-- AM/PM用 -->
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="24" />
                            <!-- AM/PM用 -->
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <!-- 日付用 -->
                            <RowDefinition Height="Auto" />
                            <!-- 曜日用 -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Width は DataGrid の AM/PM ヘッダーの ActualWidth にバインドします。 -->
                        <Label Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Content="12/1" HorizontalContentAlignment="Center" />
                        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Content="火" HorizontalContentAlignment="Center"/>
                        <Label Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Content="12/2" HorizontalContentAlignment="Center" />
                        <Label Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Content="水" HorizontalContentAlignment="Center"/>
                        <Label Grid.Row="0" Grid.Column="5" Grid.ColumnSpan="2" Content="12/3" HorizontalContentAlignment="Center" />
                        <Label Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="2" Content="木" HorizontalContentAlignment="Center"/>
                    </Grid>
                    <DataGrid Grid.Row="1" x:Name="BodyDataGrid0"
                              ItemsSource="{Binding Schedules0.DefaultView, Mode=OneWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="All"
                    />
                </Grid>
            </ScrollViewer>

            <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="5" HorizontalAlignment="Stretch" Background="Gray" />

            <Label Grid.Row="2" Grid.Column="0" Content="{Binding VerticalFloorName1}" />
            <ScrollViewer Grid.Row="2" Grid.Column="1" x:Name="ScrollViewer1"
                          HorizontalScrollBarVisibility="Visible"
                          VerticalScrollBarVisibility="Hidden">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" x:Name="HeaderGrid1" ShowGridLines="true" />
                    <DataGrid Grid.Row="1" x:Name="BodyDataGrid1"
                              ItemsSource="{Binding Schedules1.DefaultView, Mode=OneWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="All"
                    />
                </Grid>
            </ScrollViewer>

            <GridSplitter Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Height="5" HorizontalAlignment="Stretch" Background="Gray" />

            <Label Grid.Row="4" Grid.Column="0" Content="{Binding VerticalFloorName2}" />
            <ScrollViewer Grid.Row="4" Grid.Column="1" x:Name="ScrollViewer2"
                          HorizontalScrollBarVisibility="Visible"
                          VerticalScrollBarVisibility="Hidden">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" x:Name="HeaderGrid2" ShowGridLines="true" />
                    <DataGrid Grid.Row="1" x:Name="BodyDataGrid2"
                              ItemsSource="{Binding Schedules2.DefaultView, Mode=OneWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="All"
                    />
                </Grid>
            </ScrollViewer>
        </Grid>


    </DockPanel>
</Window>
