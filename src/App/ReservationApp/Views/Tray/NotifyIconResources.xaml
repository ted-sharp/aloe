<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="d"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tb="http://www.hardcodet.net/taskbar"
                    xmlns:vm="clr-namespace:AloeReservationGrid.App.ReservationApp.ViewModels">
    <ContextMenu
        x:Shared="false"
        x:Key="SysTrayMenu"
        d:DataContext="{d:DesignInstance Type=vm:NotifyIconViewModel, IsDesignTimeCreatable=True}"
    >
        <MenuItem
            Header="予約状況(メイン)"
            Command="{Binding ShowReservationMainWindowCommand}"
        />
        <MenuItem
            Header="団体患者検索"
            Command="{Binding ShowXxxWindowCommand}"
        />
        <MenuItem
            Header="設定"
            Command="{Binding ShowMaintenanceWindowCommand}"
        />
        <MenuItem
            Header="バージョン情報"
            Command="{Binding ShowXxxWindowCommand}"
        />
        <Separator />
        <MenuItem
            Header="ログイン"
            Command="{Binding ShowLoginWindowCommand}"
        />
        <Separator />
        <MenuItem
            Header="再起動"
            Command="{Binding RestartAppCommand}"
        />
        <MenuItem
            Header="終了"
            Command="{Binding ExitAppCommand}"
        />
    </ContextMenu>

    <!--  the application's NotifyIcon - started from App.xaml.cs. Declares its own view model.  -->
    <tb:TaskbarIcon
        x:Key="NotifyIcon"
        d:DataContext="{d:DesignInstance Type=vm:NotifyIconViewModel, IsDesignTimeCreatable=True}"
        DataContext="{vm:Resolve {x:Type vm:NotifyIconViewModel}}"
        IconSource="/Assets/bookmark_schedule_date_appointment_icon_124679.ico"
        ToolTipText="ReservationApp"
        LeftClickCommand="{Binding ShowReservationMainWindowCommand}"
        NoLeftClickDelay="True"
        ContextMenu="{StaticResource SysTrayMenu}"
    />
</ResourceDictionary>